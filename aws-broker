#!/usr/bin/env python3
import argparse
import hmac
import http.server
import json
import os
import secrets
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def parse_args():
    p = argparse.ArgumentParser()
    p.add_argument("--profile", required=True)
    p.add_argument("--watch-pid", type=int, required=True)
    p.add_argument("--min-remint-interval", type=float, default=5)
    p.add_argument("--idle-timeout", type=float, default=14400)
    return p.parse_args()


# "2024-01-01T00:00:00Z" and "...+00:00" both come back from different
# botocore versions of `export-credentials --format process`; fromisoformat
# only accepts the second shape.
def parse_expiration(expiration):
    if expiration.endswith("Z"):
        expiration = expiration[:-1] + "+00:00"
    return datetime.fromisoformat(expiration)


def seconds_to_expiry(expiration):
    return (parse_expiration(expiration) - datetime.now(timezone.utc)).total_seconds()


# Runs the host's full credential resolution for the profile (including any
# credential_process, e.g. one that shells out to 1Password) and returns the
# process-format JSON, or (None, <one-line error>) on any failure. Never
# raises: every caller turns a failure into ERROR=/500 output instead.
def export_credentials(profile):
    try:
        proc = subprocess.run(
            ["aws", "configure", "export-credentials", "--profile", profile, "--format", "process"],
            capture_output=True,
            text=True,
            timeout=30,
        )
    except subprocess.TimeoutExpired:
        return None, "'aws configure export-credentials' timed out after 30s"
    except FileNotFoundError:
        return None, "'aws' is not on PATH"

    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        return None, f"'aws configure export-credentials --profile {profile}' failed: {detail}"

    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError as e:
        return None, f"unparseable export-credentials output: {e}"

    if not data.get("SessionToken"):
        return None, (
            f"profile '{profile}' returned no SessionToken — these are long-lived keys and "
            "must never enter the guest. Point YOLOBOX_AWS_PROFILE at a profile that yields "
            "temporary credentials (role_arn or credential_process), not a static IAM user profile."
        )

    return {
        "AccessKeyId": data["AccessKeyId"],
        "SecretAccessKey": data["SecretAccessKey"],
        "Token": data["SessionToken"],
        "Expiration": data["Expiration"],
    }, None


class State:
    def __init__(self, profile, min_remint_interval, initial_creds):
        self.profile = profile
        self.min_remint_interval = min_remint_interval
        self.lock = threading.Lock()
        self.creds = initial_creds
        self.last_mint_attempt = time.monotonic()
        self.last_mint_error = None
        self.last_creds_hit = time.monotonic()

    def _remint_locked(self):
        creds, err = export_credentials(self.profile)
        self.last_mint_attempt = time.monotonic()
        if err:
            self.last_mint_error = err
            log(f"remint failed: {err}")
            return
        self.creds = creds
        self.last_mint_error = None

    # Returns fresh-enough creds, or None when nothing usable is left.
    # Re-mints synchronously (holding the lock) when the cache is within
    # 10 minutes of expiry, throttled to at most one attempt per
    # min-remint-interval — a mint failure while the cache is still
    # genuinely unexpired keeps serving the stale cache rather than 500ing.
    def get(self):
        with self.lock:
            self.last_creds_hit = time.monotonic()
            needs_remint = self.creds is None or seconds_to_expiry(self.creds["Expiration"]) < 600
            if needs_remint and (time.monotonic() - self.last_mint_attempt) >= self.min_remint_interval:
                self._remint_locked()
            if self.creds is None or seconds_to_expiry(self.creds["Expiration"]) <= 0:
                return None
            return self.creds


class Handler(http.server.BaseHTTPRequestHandler):
    def __init__(self, state, token, *args, **kwargs):
        self.state = state
        self.token = token
        super().__init__(*args, **kwargs)

    # Overridden rather than relying on the base class default so this stays
    # true even if a future edit adds a header dump for debugging: request
    # line, status and timestamp only, nothing from the Authorization header
    # or a response body ever reaches this line.
    def log_message(self, fmt, *args):
        log(f"{self.address_string()} - {self.log_date_time_string()} - {fmt % args}")

    def _send_json(self, status, payload):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/health":
            body = b"ok"
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        if self.path == "/creds":
            # Sent verbatim as the Authorization header value by botocore's
            # container credential provider — not a "Bearer <token>" scheme.
            auth = self.headers.get("Authorization", "")
            if not hmac.compare_digest(auth, self.token):
                self._send_json(401, {"code": "AccessDenied", "message": "invalid or missing Authorization"})
                return

            creds = self.state.get()
            if creds is None:
                detail = self.state.last_mint_error or "no credentials available"
                self._send_json(
                    500,
                    {
                        "code": "CredentialsNotAvailable",
                        "message": (
                            f"host-side mint failed: {detail}. Run 'aws sso login' on the "
                            "Mac and retry — no re-enter needed."
                        ),
                    },
                )
                return

            self._send_json(
                200,
                {
                    "AccessKeyId": creds["AccessKeyId"],
                    "SecretAccessKey": creds["SecretAccessKey"],
                    "Token": creds["Token"],
                    "Expiration": creds["Expiration"],
                },
            )
            return

        self.send_response(404)
        self.end_headers()


def watch_pid(pid):
    while True:
        time.sleep(5)
        try:
            os.kill(pid, 0)
        except (ProcessLookupError, PermissionError):
            os._exit(0)


def idle_watch(state, idle_timeout):
    interval = max(1.0, min(30.0, idle_timeout / 4))
    while True:
        time.sleep(interval)
        with state.lock:
            idle = time.monotonic() - state.last_creds_hit
        if idle >= idle_timeout:
            log(f"idle for {idle:.0f}s (>= {idle_timeout}s) — exiting")
            os._exit(0)


def main():
    args = parse_args()

    initial_creds, err = export_credentials(args.profile)
    if err:
        print(f"ERROR={err}")
        sys.stdout.flush()
        sys.exit(1)

    state = State(args.profile, args.min_remint_interval, initial_creds)
    token = secrets.token_urlsafe(32)

    server = http.server.ThreadingHTTPServer(
        ("127.0.0.1", 0), lambda *a, **kw: Handler(state, token, *a, **kw)
    )
    port = server.server_address[1]

    # This IS the handshake: the first two stdout lines, then never another
    # byte to stdout. The dup2 below closes the window where a later write
    # (e.g. an accidental print) could block a reader that only ever reads
    # two lines.
    print(f"TOKEN={token}")
    print(f"PORT={port}")
    sys.stdout.flush()

    devnull_fd = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull_fd, 1)
    os.close(devnull_fd)

    threading.Thread(target=watch_pid, args=(args.watch_pid,), daemon=True).start()
    threading.Thread(target=idle_watch, args=(state, args.idle_timeout), daemon=True).start()

    server.serve_forever()


if __name__ == "__main__":
    main()
