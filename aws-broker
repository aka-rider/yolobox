#!/usr/bin/env python3
import argparse
import http.server
import json
import os
import select
import socket
import socketserver
import stat
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def fail(msg):
    print(f"ERROR={msg}")
    sys.stdout.flush()
    sys.exit(1)


def parse_args():
    p = argparse.ArgumentParser()
    p.add_argument("--socket", required=True, metavar="PATH")
    p.add_argument("--watch-pid", type=int, required=True)
    p.add_argument("--allow", nargs="+", required=True, metavar="PROFILE")
    p.add_argument("--min-remint-interval", type=float, default=5.0)
    return p.parse_args()


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def reclaim_socket_path(path):
    try:
        mode = os.lstat(path).st_mode
    except FileNotFoundError:
        return
    except OSError as e:
        fail(f"cannot stat existing path {path}: {e}")
    if not stat.S_ISSOCK(mode):
        fail(f"{path} exists and is not a socket; refusing to remove it")

    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    probe.settimeout(1.0)
    try:
        probe.connect(path)
    except ConnectionRefusedError:
        pass
    except FileNotFoundError:
        return
    except OSError as e:
        fail(f"cannot probe existing socket {path}: {e}")
    else:
        fail(f"another aws-broker is already serving {path}")
    finally:
        probe.close()

    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    except OSError as e:
        fail(f"cannot remove stale socket {path}: {e}")


def unlink_if_same_identity(path, identity):
    try:
        st = os.stat(path)
    except OSError:
        return
    if (st.st_dev, st.st_ino) == identity:
        try:
            os.unlink(path)
        except OSError:
            pass


def register_pid_watch_event(pid):
    """Register a kqueue watch for process exit, without waiting for it."""
    kq = select.kqueue()
    event = select.kevent(pid, filter=select.KQ_FILTER_PROC, flags=select.KQ_EV_ADD, fflags=select.KQ_NOTE_EXIT)
    try:
        kq.control([event], 0)
    except ProcessLookupError:
        fail(f"watched pid {pid} is not running")
    except OSError as e:
        fail(f"kqueue registration for watched pid {pid} failed: {e}")
    return kq


def wait_for_pid_exit(pid, socket_path, identity, kq):
    try:
        kq.control([], 1)
    except OSError:
        pass
    log(f"watched pid {pid} exited; shutting down")
    unlink_if_same_identity(socket_path, identity)
    os._exit(0)


# "2024-01-01T00:00:00Z" and "...+00:00" both come back from different
# botocore versions of `export-credentials --format process`; fromisoformat
# only accepts the second shape.
def parse_expiration(expiration):
    if expiration.endswith("Z"):
        expiration = expiration[:-1] + "+00:00"
    return datetime.fromisoformat(expiration)


def seconds_to_expiry(expiration):
    return (parse_expiration(expiration) - datetime.now(timezone.utc)).total_seconds()


# Runs the host's full credential resolution for the profile (including any
# credential_process, e.g. one that shells out to 1Password) and returns the
# process-format JSON, or (None, <one-line error>) on any failure. Never
# raises: every caller turns a failure into ERROR=/500 output instead.
def export_credentials(profile):
    try:
        proc = subprocess.run(
            ["aws", "configure", "export-credentials", "--profile", profile, "--format", "process"],
            capture_output=True,
            text=True,
            timeout=30,
        )
    except subprocess.TimeoutExpired:
        return None, "'aws configure export-credentials' timed out after 30s"
    except FileNotFoundError:
        return None, "'aws' is not on PATH"

    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        return None, f"'aws configure export-credentials --profile {profile}' failed: {detail}"

    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError as e:
        return None, f"unparseable export-credentials output: {e}"

    if not data.get("SessionToken"):
        return None, (
            f"profile '{profile}' returned no SessionToken — these are long-lived keys and "
            "must never be served to the guest. Remove it from the broker's --allow list, or "
            "point its aws config at a role_arn/credential_process instead of a static IAM user."
        )

    return {
        "AccessKeyId": data["AccessKeyId"],
        "SecretAccessKey": data["SecretAccessKey"],
        "SessionToken": data["SessionToken"],
        "Expiration": data["Expiration"],
    }, None


class State:
    def __init__(self, profile, min_remint_interval):
        self.profile = profile
        self.min_remint_interval = min_remint_interval
        self.lock = threading.Lock()
        self.creds = None
        self.last_mint_attempt = None
        self.last_mint_error = None

    def _remint_locked(self):
        log(f"{self.profile}: minting credentials")
        creds, err = export_credentials(self.profile)
        self.last_mint_attempt = time.monotonic()
        if err:
            self.last_mint_error = err
            log(f"{self.profile}: mint failed: {err}")
            return
        self.creds = creds
        self.last_mint_error = None
        log(f"{self.profile}: minted, expires {creds['Expiration']}")

    # Returns fresh-enough creds, or None when nothing usable is left.
    # Re-mints synchronously (holding the lock) when the cache is within
    # 10 minutes of expiry, throttled to at most one attempt per
    # min-remint-interval — a mint failure while the cache is still
    # genuinely unexpired keeps serving the stale cache rather than 500ing.
    def get(self):
        with self.lock:
            needs_remint = self.creds is None or seconds_to_expiry(self.creds["Expiration"]) < 600
            throttled = (
                self.last_mint_attempt is not None
                and (time.monotonic() - self.last_mint_attempt) < self.min_remint_interval
            )
            if needs_remint and not throttled:
                self._remint_locked()
            if self.creds is None or seconds_to_expiry(self.creds["Expiration"]) <= 0:
                return None
            return self.creds


class UnixHTTPServer(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True


class Handler(http.server.BaseHTTPRequestHandler):
    def __init__(self, states, watch_pid, *args, **kwargs):
        self.states = states
        self.watch_pid = watch_pid
        super().__init__(*args, **kwargs)

    # AF_UNIX hands back '' as client_address (there is no peer host/port),
    # so the base class's address_string(), which indexes it as
    # client_address[0], would raise. The path is only reachable by the
    # agent account anyway (the socket is 0600), so a fixed label is enough.
    def address_string(self):
        return "unix-socket"

    def log_message(self, fmt, *args):
        log(f"{self.address_string()} - {self.log_date_time_string()} - {fmt % args}")

    def _send_json(self, status, payload):
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_text(self, status, body):
        encoded = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def do_GET(self):
        if self.path == "/health":
            self._send_json(200, {
                "pid": os.getpid(),
                "watch_pid": self.watch_pid,
                "allow": sorted(self.states),
            })
            return

        if self.path.startswith("/creds/"):
            profile = self.path[len("/creds/"):]

            state = self.states.get(profile)
            if state is None:
                allowed = ", ".join(sorted(self.states)) or "(none)"
                self._send_text(403, f"profile '{profile}' is not allowlisted; allowed: {allowed}\n")
                return

            creds = state.get()
            if creds is None:
                detail = state.last_mint_error or "no credentials available"
                self._send_text(500, f"aws sso login --profile {profile}\n{detail}\n")
                return

            self._send_json(200, {"Version": 1, **creds})
            return

        self.send_response(404)
        self.end_headers()


def main():
    args = parse_args()

    if not pid_alive(args.watch_pid):
        fail(f"watched pid {args.watch_pid} is not running")

    reclaim_socket_path(args.socket)

    states = {profile: State(profile, args.min_remint_interval) for profile in args.allow}

    # Only the socket file's own mode governs who can connect: no bearer
    # token guards these requests, and this file only ever runs on the Mac,
    # which has no separate agent account — 0600 restricts the socket to
    # this Mac user's own processes, with no window where it is
    # world-connectable. bind() creates the socket file at mode 0777 &
    # ~umask, so clearing every group/other/execute bit needs umask 0o177,
    # not the 0o077 that a regular file's 0666 default would call for.
    old_umask = os.umask(0o177)
    try:
        server = UnixHTTPServer(args.socket, lambda *a, **kw: Handler(states, args.watch_pid, *a, **kw))
    except OSError as e:
        fail(f"cannot bind unix socket {args.socket}: {e}")
    finally:
        os.umask(old_umask)

    st = os.stat(args.socket)
    identity = (st.st_dev, st.st_ino)

    kq = register_pid_watch_event(args.watch_pid)

    print("READY")
    sys.stdout.flush()

    devnull_fd = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull_fd, 1)
    os.close(devnull_fd)

    threading.Thread(
        target=wait_for_pid_exit, args=(args.watch_pid, args.socket, identity, kq), daemon=True
    ).start()

    try:
        server.serve_forever()
    finally:
        unlink_if_same_identity(args.socket, identity)


if __name__ == "__main__":
    main()
