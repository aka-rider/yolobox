{
  "default_instance": "yolobox",
  "operator_uid": 501,
  "operator_home_suffix": ".guest",
  "operator_account_re": "[a-z_][a-z0-9_-]*",
  "hostname_label_re": "[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?",
  "agent_user": "agent",
  "agent_uid": 1000,
  "agent_home": "/home/agent",
  "agent_keys_command": "/etc/ssh/agent-authorized-keys",
  "stage2_ssh_banner_mark": "yolobox-stage2",
  "initrd_ssh_banner_mark": "yolobox-initrd",
  "version_stamp": "/etc/yolobox/version",
  "flake_ref_stamp": "/etc/yolobox/flake-ref",
  "gateway": "192.168.5.2",
  "guest_addr": "192.168.5.15",
  "guest_nic": "enp0s1",
  "guest_ssh_port": 22,
  "ssh_local_port": 60022,
  "op_agent_proxy_unit": "yolobox-op-agent",
  "op_guest_sock": "/run/yolobox-op/agent.sock",
  "agent_auth_sock": "/run/yolobox/op-agent.sock",
  "aws_broker_proxy_unit": "yolobox-aws-broker",
  "aws_broker_guest_sock": "/run/yolobox-op/aws-broker.sock",
  "agent_aws_broker_sock": "/run/yolobox/aws-broker.sock",
  "luks_device": "/dev/vda2",
  "luks_mapper": "root",
  "luks_label": "yolobox-luks",
  "luks_encrypt_unit": "yolobox-luks-encrypt",
  "unlock_exit_wrong_key": 1,
  "unlock_exit_encrypt_failed": 2,
  "unlock_exit_watch_failed": 3,
  "unlock_exit_no_passphrase": 4,
  "unlock_exit_mount_failed": 5,
  "unlock_exit_unexpected": 6,
  "unlock_exit_open_failed": 7,
  "unlock_unlocked_line": "yolobox-unlock: unlocked",
  "egress_unit": "yolobox-egress",
  "network_ready_unit": "yolobox-network-ready",
  "usage_exit": 64,
  "rebuild_lock": "/run/yolobox-rebuild.lock",
  "rebuild_busy_exit": 75,
  "nix_env_username": "YOLOBOX_USERNAME",
  "nix_env_hostname": "YOLOBOX_HOSTNAME",
  "nix_env_flake_ref": "YOLOBOX_FLAKE_REF",
  "nix_env_skip_local_nix": "YOLOBOX_SKIP_LOCAL_NIX",
  "profile_name_re": "[A-Za-z0-9][A-Za-z0-9._-]*",
  "gc_build_dirs": ["node_modules", "target", ".next"],
  "gc_removed_outright": ["node_modules", ".venv"],
  "vm_user": "yolobox-vm",
  "passt_dir": "/run/libvirt/qemu/passt",
  "host_resolv_conf": "/etc/resolv.conf",
  "host_resolv_conf_type": "net_conf_t",
  "domain_ns": "https://github.com/aka-rider/yolobox",
  "initrd_unlock_helper": "yolobox-unlock",
  "ask_password_dir": "/run/systemd/ask-password",
  "build_output_manifests": {"target": "Cargo.toml", ".next": "package.json"}
}
