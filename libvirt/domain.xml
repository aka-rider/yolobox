<domain type='kvm'>
  <name>yolobox-$name</name>
  <metadata>
    <yolobox:instance xmlns:yolobox='https://github.com/aka-rider/yolobox'>$name</yolobox:instance>
  </metadata>
  <memory unit='GiB'>16</memory>
  <vcpu placement='static'>8</vcpu>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
    <firmware>
      <feature enabled='no' name='secure-boot'/>
    </firmware>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-passthrough' check='none'/>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <disk type='volume' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source pool='default' volume='yolobox-$name.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <disk type='volume' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source pool='default' volume='yolobox-$name-cidata.iso'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
    <controller type='usb' model='none'/>
    <interface type='user'>
      <backend type='passt'/>
      <model type='virtio'/>
      <ip family='ipv4' address='192.168.5.15' prefix='24'/>
      <route family='ipv4' gateway='192.168.5.2'/>
      <portForward proto='tcp' address='127.0.0.1'>
        <range start='$ssh_port' to='22'/>
      </portForward>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x01' function='0x0'/>
    </interface>
    <serial type='pty'>
      <target type='isa-serial' port='0'>
        <model name='isa-serial'/>
      </target>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <video>
      <model type='none'/>
    </video>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
    <memballoon model='none'/>
  </devices>
  <seclabel type='dynamic' model='selinux' relabel='yes'/>
  <seclabel type='static' model='dac' relabel='yes'>
    <label>+$uid:+$gid</label>
  </seclabel>
</domain>
