# Host-side egress filter for the Linux host. Everything the guest sends out
# leaves through passt, which turns a guest connection into an ordinary
# socket on the host. libvirt starts passt and QEMU as the system user
# yolobox-vm, so those sockets carry that uid and this table can judge them.
# The guest cannot undo it: it is a host table, loaded before virtqemud.
#
# The output chain sends only packets whose socket belongs to yolobox-vm to the
# chain `vm`, and accepts the rest by policy. It must be a positive match:
# a packet with no full socket (kernel IPv6 neighbour discovery, MLD, IGMP,
# kernel NFS, CIFS or WireGuard sockets) has no uid, so `meta skuid` breaks
# the rule, and `!=` would not match it either, so those host packets would
# fall through to the rejects. In `vm`, the host's loopback (where passt maps
# the guest's gateway) is reachable on DNS only, and the private and
# link-local ranges that nix/egress/yolobox-egress.nft blocks inside the guest
# are rejected here too. Keep the two address sets equal to that file.
# The table is defined, deleted and defined again in one file, so a reload
# replaces it atomically and a failed load leaves the old table in place.

table inet yolobox-host {}
delete table inet yolobox-host
table inet yolobox-host {
  chain vm {
    ct state established,related accept
    oifname "lo" ip daddr 127.0.0.0/8 meta l4proto { tcp, udp } th dport 53 accept
    oifname "lo" reject
    ip daddr { 10.0.0.0/8, 100.64.0.0/10, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } reject
    ip6 daddr { fc00::/7, fe80::/10, ff00::/8, 64:ff9b:1::/48, ::1 } reject
  }
  chain output {
    type filter hook output priority 0; policy accept;
    meta skuid "yolobox-vm" goto vm
  }
}
