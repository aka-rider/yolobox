[Unit]
Description=Reject yolobox guest traffic to the host and private networks
Before=virtqemud.service
# After the host's own firewall managers: an nftables.conf that starts with
# `flush ruleset` would otherwise drop this table at boot while the unit stays
# active. No PartOf= either: nothing may stop or restart this table with
# another unit.
After=nftables.service firewalld.service

# No ExecStop, on purpose: stopping the unit must never open the host. The
# table stays loaded until someone deletes it by hand.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/yolobox/yolobox-host.nft
# Creates the passt socket directory before virtqemud's first passt domain. It
# is no /etc/tmpfiles.d file: dracut copies that directory into the initrd,
# which has no qemu account. After the table, so a failure here never leaves
# the host without it.
ExecStart=/usr/bin/systemd-tmpfiles --create /etc/yolobox/yolobox-passt.conf
ExecReload=/usr/sbin/nft -f /etc/yolobox/yolobox-host.nft

[Install]
WantedBy=multi-user.target
RequiredBy=virtqemud.service
