class YoError(Exception):
    def __init__(self, message: Optional[str] = None, code: int = 1, show_usage: bool = False):
        super().__init__(message or "")
        self.message = message
        self.code = code
        self.show_usage = show_usage


def usage_error(message: str) -> YoError:
    return YoError(message, code=2, show_usage=True)


