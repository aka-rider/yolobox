        "<group>/.gitconfig under the top-level trees the VM's home shares with\n"
        "this Mac's. Never a private key. Re-run after the first link on a\n"
        "fresh VM.",
    )
    seed.set_defaults(func=cmd_seed)

    code = add(
        "code",
        "Open VS Code Remote-SSH in the VM.",
        "Open VS Code Remote-SSH in the VM, as the agent account. Needs\n"
        "\"Include ~/.lima/yolobox/ssh.config\" in ~/.ssh/config (yo code offers to\n"
        "add it otherwise); also needs the ms-vscode-remote.remote-ssh extension.",
    )
    code.add_argument("project", nargs="?")
    code.set_defaults(func=cmd_code)

    zed = add(
        "zed",
        "Open Zed in the VM.",
        "Open Zed in the VM, as the agent account. Needs\n"
        "\"Include ~/.lima/yolobox/ssh.config\" in ~/.ssh/config (yo zed offers to\n"
        "add it otherwise).",
    )
    zed.add_argument("project", nargs="?")
    zed.set_defaults(func=cmd_zed)

    t3 = add(
        "t3",
        "Open t3code's web UI in this Mac's browser.",
        "Open t3code's web UI, served by the VM, in this Mac's browser with a\n"
        "fresh pairing token. A bookmarked URL fails auth; run this again.",
    )
    t3.set_defaults(func=cmd_t3)

    pair = add(
        "pair",
        "Print a t3 pairing URL for a browser on another device.",
        "Print a t3 pairing URL that names this Mac (default\n"
        "http://<hostname>.local:3773) for a browser on another device.",
    )
    pair.add_argument("base_url", nargs="?", metavar="base-url")
    pair.set_defaults(func=cmd_pair)

    aws_check = add(
        "aws-check",
        "Prove end to end that YOLOBOX_AWS_PROFILE's credentials reach the VM.",
        "Prove end to end that YOLOBOX_AWS_PROFILE's credentials reach the VM:\n"
        "host export-credentials, a throwaway broker and forward, the guest's\n"
        "/health and /creds, and a guest sts get-caller-identity.",
    )
    aws_check.set_defaults(func=cmd_aws_check)

    return parser


def main(argv: Sequence[str]) -> int:
    args = build_parser().parse_args(argv)
    require_tool("limactl", "brew install lima")
    args.func(args)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except YoError as failure:
        if failure.message:
            err("yo: %s" % failure.message)
        sys.exit(failure.code)
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        os._exit(0)
