class YoError(Exception):
    def __init__(self, message: Optional[str] = None, code: int = 1):
        super().__init__(message or "")
        self.message = message
        self.code = code


def out(line: str = "") -> None:
    print(line, flush=True)


def err(line: str = "") -> None:
    print(line, file=sys.stderr, flush=True)


class Report:
    def __init__(self) -> None:
        self.failed = False

    def ok(self, message: str) -> None:
        out("ok:   %s" % message)

    def fail(self, message: str, *remedies: str) -> None:
        self.failed = True
        err("FAIL: %s" % message)
        for remedy in remedies:
            err("      %s" % remedy)

    def abort(self, message: str, *remedies: str) -> "YoError":
        self.fail(message, *remedies)
        return YoError(None, code=1)


def guest_helper_check(
    proc: subprocess.CompletedProcess, what: str
) -> subprocess.CompletedProcess:
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        raise YoError(
            "%s failed (exit %d)%s"
            % (what, proc.returncode, ": " + detail if detail else "")
        )
    return proc


def require_tool(name: str, hint: str) -> str:
    path = shutil.which(name)
    if path is None:
        raise YoError("%s not found (%s)" % (name, hint))
    return path


def run(
    argv: Sequence[str],
    *,
    capture: bool = True,
    check: bool = False,
    stdin: Optional[bytes] = None,
    env: Optional[Dict[str, str]] = None,
    merge_stderr: bool = False,
    binary: bool = False,
) -> subprocess.CompletedProcess:
    proc = subprocess.run(
        list(argv),
        input=stdin,
        stdout=subprocess.PIPE if capture else None,
        stderr=(subprocess.STDOUT if merge_stderr else subprocess.PIPE) if capture else None,
        env=env,
    )
    if capture:
        proc.stdout = proc.stdout or b""
        if not binary:
            proc.stdout = proc.stdout.decode("utf-8", "replace").replace("\r", "")
        if proc.stderr is not None:
            proc.stderr = proc.stderr.decode("utf-8", "replace").replace("\r", "")
    if check and proc.returncode != 0:
        if capture:
            stdout_text = proc.stdout.decode("utf-8", "replace") if binary else proc.stdout
            detail = (proc.stderr or stdout_text or "").strip()
        else:
            detail = ""
        raise YoError(
            "%s failed (exit %d)%s" % (shlex.join(argv), proc.returncode, ": " + detail if detail else "")
        )
    return proc


def exec_process(argv: Sequence[str], env: Optional[Dict[str, str]] = None) -> None:
    # CPython starts with SIGPIPE ignored and exec preserves an ignored
    # disposition, so a pipeline reader that exits would leave the exec'd
    # process seeing EPIPE instead of dying, unlike bash's `exec ssh`.
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    os.execvpe(argv[0], list(argv), env if env is not None else os.environ)


@dataclass(frozen=True)
class SshRole:
    user: Optional[str]
    own_control_path: bool


OPERATOR = SshRole(None, False)
AGENT = SshRole(AGENT_USER, True)


def ssh_base(role: SshRole, mux: bool = False) -> List[str]:
    ensure_agent_ssh_config()
    argv = ["ssh", "-F", ssh_cfg()]
    if role.user is not None:
        argv += ["-o", "User=%s" % role.user]
    if not mux:
        argv += ["-o", "ControlPath=none"]
    elif role.own_control_path:
        argv += ["-o", "ControlPath=%s" % agent_control_path()]
    return argv


def remote(argv: Sequence[str]) -> str:
    return shlex.join(argv)


def forward_agent_opts() -> List[str]:
    return ["-o", 'ForwardAgent="%s"' % op_sock()]


def ssh_run(
    role: SshRole,
    argv: Sequence[str],
    *,
    stdin: Optional[bytes] = None,
    extra_opts: Sequence[str] = (),
    env: Optional[Dict[str, str]] = None,
    mux: bool = False,
    capture: bool = True,
    check: bool = False,
    merge_stderr: bool = False,
    inherit_stdin: bool = False,
    binary: bool = False,
) -> subprocess.CompletedProcess:
    cmd = ssh_base(role, mux=mux) + list(extra_opts)
    if stdin is None and not inherit_stdin:
        cmd.append("-n")
    cmd += [VM_HOST, remote(argv)]
    return run(
        cmd,
        capture=capture,
        check=check,
        stdin=stdin,
        env=env,
        merge_stderr=merge_stderr,
        binary=binary,
    )


def guest_out(argv: Sequence[str], *, check: bool = True, mux: bool = False) -> str:
    return ssh_run(OPERATOR, argv, mux=mux, check=check).stdout


def agent_out(argv: Sequence[str], *, check: bool = True, mux: bool = False) -> str:
    return ssh_run(AGENT, argv, mux=mux, check=check).stdout


def helper_missing(role: SshRole) -> bool:
    return ssh_run(role, ["command", "-v", HELPER]).returncode != 0


def guest_helper(
    role: SshRole, sub: str, args: Sequence[str] = (), *, stream: bool = False, **kwargs
) -> subprocess.CompletedProcess:
    if stream:
        kwargs["capture"] = False
    proc = ssh_run(role, [HELPER, sub, *args], **kwargs)
    if proc.returncode not in (127, HELPER_NO_SUBCOMMAND):
        return proc
    # A streamed run has no captured stderr to match the marker against, so the
    # two skews are told apart by asking the box directly instead.
    if stream:
        if helper_missing(role):
            raise YoError(helper_skew("the box has no %s" % HELPER))
        if proc.returncode == HELPER_NO_SUBCOMMAND:
            raise YoError(helper_skew("the box's %s has no '%s' subcommand" % (HELPER, sub)))
        return proc
    if proc.returncode == 127 and "not found" in (proc.stderr or ""):
        raise YoError(helper_skew("the box has no %s" % HELPER))
    if proc.returncode == HELPER_NO_SUBCOMMAND and HELPER_MARKER in (proc.stderr or ""):
        raise YoError(helper_skew("the box's %s has no '%s' subcommand" % (HELPER, sub)))
    return proc


def agent_paths(sub: str, args: Sequence[str] = (), *, check: bool = True) -> List[str]:
    proc = guest_helper(AGENT, sub, args, binary=True)
    if proc.returncode != 0:
        if check:
            guest_helper_check(proc, sub)
        else:
            stderr = proc.stderr
            if isinstance(stderr, bytes):
                stderr = stderr.decode("utf-8", "replace")
            err(
                "yo: the project walk could not read every directory under %s (find exit %d)."
                % (AGENT_HOME, proc.returncode)
            )
            err(
                "    The list below is what was readable; a project under an unreadable "
                "directory is missing from it."
            )
    decoded = proc.stdout.decode("utf-8", "replace")
    return [entry for entry in decoded.split("\0") if entry]


def account_status() -> Tuple[str, str]:
    agent_probe = ssh_run(AGENT, ["true"])
    if agent_probe.returncode == 0:
        return "agent", ""
    if ssh_run(OPERATOR, ["true"]).returncode == 0:
        return "operator_only", ""
    return "unreachable", agent_probe.stderr.rstrip("\n")


def require_agent_account() -> None:
    status, detail = account_status()
    if status == "agent":
        return
    if status == "operator_only":
        err("yo: cannot ssh into %s as '%s'." % (INSTANCE, AGENT_USER))
        err("    Every AI session runs as that account, and this VM has no working one —")
        err("    it predates the operator/agent split. Rebuild it:")
        err("        limactl delete %s && yo bootstrap" % INSTANCE)
    else:
        if detail:
            err(detail)
        err("yo: cannot reach %s as operator either — is the VM up? yo status" % INSTANCE)
    raise YoError(None, code=1)


def require_operator_uid() -> None:
    uid = ssh_run(OPERATOR, ["id", "-u"], check=True).stdout.strip()
    if uid == OPERATOR_UID:
        return
    err("yo: the VM's operator account is uid %s, not %s." % (uid, OPERATOR_UID))
    err("    It was created from a yaml with no user.uid pin. Rebuild it:")
    err("        limactl delete %s && yo bootstrap" % INSTANCE)
    raise YoError(None, code=1)


def guest_path(path: str) -> str:
    if "\0" in path or "\n" in path:
        raise YoError("refusing a guest path with a newline or NUL byte")
    normalised = os.path.normpath(path)
    if normalised != AGENT_HOME and not normalised.startswith(AGENT_HOME + "/"):
        raise YoError(
            'refusing to target "%s": no yo command may leave the guest home "%s"'
            % (path, AGENT_HOME)
        )
    return normalised


def logical_cwd() -> str:
    pwd_env = os.environ.get("PWD", "")
    if os.path.isabs(pwd_env):
        try:
            if os.path.samefile(pwd_env, os.getcwd()):
                return pwd_env
        except OSError:
            pass
    return os.getcwd()


def mirror(mac_path: str) -> Optional[str]:
    host = home()
    if mac_path == host:
        return AGENT_HOME
    if mac_path.startswith(host + "/"):
        return AGENT_HOME + "/" + mac_path[len(host) + 1 :]
    return None


@dataclass(frozen=True)
class CpPlan:
    direction: str
    local_paths: List[str]
    guest_paths: List[str]


def operand_is_guest(operand: str) -> bool:
    return operand.startswith(":")


def resolve_guest_operand(operand: str, cwd_mirror: Optional[str]) -> str:
    spelling = operand[1:]
    if spelling == "~" or spelling.startswith("~/"):
        return guest_path(AGENT_HOME + spelling[1:])
    if spelling.startswith("/"):
        return guest_path(spelling)
    if cwd_mirror is None:
        raise YoError(
            'guest path "%s" is relative, and the host cwd is outside $HOME; '
            'spell it as ":~/..." instead' % operand
        )
    if spelling == "":
        return guest_path(cwd_mirror)
    return guest_path(cwd_mirror + "/" + spelling)


def resolve_cp_operands(operands: List[str], cwd_mirror: Optional[str]) -> CpPlan:
    if len(operands) < 2:
        raise YoError("yo cp needs at least one source and a destination")
    sources = operands[:-1]
    dest = operands[-1]
    if not any(operand_is_guest(operand) for operand in operands):
        raise YoError(
            'no guest path given (an operand must start with ":"); use plain "cp" for a local copy'
        )
    source_guest_flags = [operand_is_guest(source) for source in sources]
    dest_is_guest = operand_is_guest(dest)
    if len(set(source_guest_flags)) > 1:
        raise YoError("sources are split between the host and the guest; every source must be on one side")
    sources_are_guest = source_guest_flags[0]
    if sources_are_guest and dest_is_guest:
        raise YoError('sources and destination are both in the guest; use "yo enter" and a plain cp there')
    if sources_are_guest:
        guest_paths = [resolve_guest_operand(source, cwd_mirror) for source in sources]
        return CpPlan(direction="from_guest", local_paths=[dest], guest_paths=guest_paths)
    guest_paths = [resolve_guest_operand(dest, cwd_mirror)]
    return CpPlan(direction="to_guest", local_paths=list(sources), guest_paths=guest_paths)


def cp_mkdir_target(dest_operand: str, resolved_dest: str, source_count: int) -> str:
    if dest_operand == ":" or dest_operand.endswith("/") or source_count > 1:
        return resolved_dest
    return os.path.dirname(resolved_dest) or AGENT_HOME


SEED_SSH_CONFIG = r"""mkdir -p ~/.ssh && chmod 700 ~/.ssh && cat >~/.ssh/config && chmod 600 ~/.ssh/config"""

SEED_UNTAR_SSH = r"""tar -C "$HOME/.ssh" -xf -"""

SEED_UNTAR_HOME = r"""tar -C "$HOME" -xf -"""

MISSING_PATH_NOTE = 'path "%s" does not exist in the yolobox you are in "%s"'


def dir_for_cwd() -> str:
    desired = mirror(logical_cwd())
    if desired is None:
        err(MISSING_PATH_NOTE % (logical_cwd(), AGENT_HOME))
        return AGENT_HOME
    landing = guest_helper_check(
        guest_helper(AGENT, "landing-dir", [desired]), "landing-dir"
    ).stdout.strip("\n")
    if landing != desired:
        err(MISSING_PATH_NOTE % (desired, landing))
    return guest_path(landing)


def pick_project(query: str) -> str:
    require_tool("fzf", tool_hint("fzf"))
    listing = agent_paths("projects", check=False)
    prefix = AGENT_HOME + "/"
    projects = sorted(
        entry[len(prefix) :] for entry in listing if entry.startswith(prefix)
    )
    if not projects:
        raise YoError("no projects in the VM")
    picker = subprocess.run(
        ["fzf", "--read0", "--print0", "--select-1", "--exit-0", "--query=" + query],
        input="\0".join(projects).encode(),
        stdout=subprocess.PIPE,
    )
    if picker.returncode != 0:
        if picker.returncode != 130:
            err("yo: no project matches '%s'" % query)
        raise YoError(None, code=picker.returncode)
    choice = picker.stdout.decode("utf-8", "replace").rstrip("\0")
    return guest_path(AGENT_HOME + "/" + choice)


def target_dir(project: Optional[str]) -> str:
    if project is not None:
        return pick_project(project)
    return dir_for_cwd()


def read_handshake(proc: subprocess.Popen, deadline: float) -> List[str]:
    fd = proc.stdout.fileno()
    buffer = b""
    while b"\n" not in buffer:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        ready, _, _ = select.select([fd], [], [], remaining)
        if not ready:
            break
        chunk = os.read(fd, 4096)
        if not chunk:
            break
        buffer += chunk
    return buffer.decode("utf-8", "replace").splitlines()


def aws_broker_sock() -> str:
    return os.path.join(state_dir(), "aws-broker.sock")


AWS_PROFILE_NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def aws_allowlist() -> List[Tuple[str, str]]:
    config_path = os.path.join(home(), ".aws", "config")
    parser = configparser.ConfigParser(interpolation=None)
    try:
        if not parser.read(config_path):
            return []
        allowed: List[Tuple[str, str]] = []
        for section in parser.sections():
            if section == "default":
                name = "default"
            elif section.startswith("profile "):
                name = section[len("profile ") :]
            else:
                continue
            if not AWS_PROFILE_NAME_RE.match(name):
                err(
                    "yo: profile '%s' has a name yo will not pass to the guest — excluded from the guest AWS config"
                    % name
                )
                continue
            if not (
                parser.has_option(section, "sso_session")
                or parser.has_option(section, "sso_start_url")
            ):
                continue
            region = parser.get(section, "region", fallback="")
            if not region:
                err(
                    "yo: profile '%s' has no region in ~/.aws/config — excluded from the guest AWS config"
                    % name
                )
                continue
            allowed.append((name, region))
    except configparser.Error as failure:
        raise YoError("cannot parse %s: %s" % (config_path, failure))
    except UnicodeDecodeError as failure:
        raise YoError("cannot read %s: %s" % (config_path, failure))
    return allowed


def guest_aws_config_text(allowed: Sequence[Tuple[str, str]]) -> str:
    return "".join(
        "[profile %s]\nregion = %s\ncredential_process = %s aws-creds %s\n"
        % (name, region, HELPER, name)
        for name, region in allowed
    )


class UnixSocketHTTPConnection(http.client.HTTPConnection):
    # http.client has no unix-socket transport of its own; overriding connect()
    # to dial an AF_UNIX socket instead of AF_INET is the documented way to add one.
    def __init__(self, path: str, timeout: float) -> None:
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self) -> None:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(self.timeout)
        sock.connect(self.unix_path)
        self.sock = sock


def aws_broker_health(timeout: float = 2.0) -> Optional[dict]:
    try:
        conn = UnixSocketHTTPConnection(aws_broker_sock(), timeout)
        try:
            conn.request("GET", "/health")
            response = conn.getresponse()
            data = response.read()
        finally:
            conn.close()
        return json.loads(data.decode())
    except (OSError, http.client.HTTPException, ValueError):
        return None


def wait_for_pid_exit(pid: int, timeout: float) -> None:
    try:
        kq = select.kqueue()
    except OSError as failure:
        raise YoError("cannot create a kqueue to wait for pid %d to exit: %s" % (pid, failure))
    try:
        event = select.kevent(
            pid,
            filter=select.KQ_FILTER_PROC,
            flags=select.KQ_EV_ADD,
            fflags=select.KQ_NOTE_EXIT,
        )
        kq.control([event], 0)
        if not kq.control(None, 1, timeout):
            raise YoError("stale aws-broker (pid %d) did not exit within %gs" % (pid, timeout))
    except ProcessLookupError:
        pass
    finally:
        kq.close()


def kill_stale_broker(pid: int) -> None:
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    except PermissionError:
        raise YoError("cannot signal the stale aws-broker (pid %d): permission denied" % pid)
    wait_for_pid_exit(pid, timeout=10.0)


def start_aws_broker(watch_pid: int, allowed_names: Sequence[str]) -> None:
    log_dir = os.path.join(state_dir(), "aws-broker")
    os.makedirs(log_dir, exist_ok=True)
    log_path = os.path.join(log_dir, "broker.log")
    with open(log_path, "wb") as log:
        proc = subprocess.Popen(
            [
                str(SCRIPT_DIR / "aws-broker"),
                "--socket",
                aws_broker_sock(),
                "--watch-pid",
                str(watch_pid),
                "--allow",
                *allowed_names,
            ],
            stdout=subprocess.PIPE,
            stderr=log,
            start_new_session=True,
            bufsize=0,
        )

    lines = read_handshake(proc, time.monotonic() + 30)
    proc.stdout.close()
    line = lines[0] if lines else ""
    if line.startswith("ERROR="):
        proc.wait()
        raise YoError("aws-broker failed: %s" % line.removeprefix("ERROR="))
    if line == "READY":
        return
    proc.terminate()
    proc.wait()
    if not line:
        raise YoError("aws-broker produced no handshake within 30s — see %s" % log_path)
    raise YoError("aws-broker produced an unexpected handshake %r — see %s" % (line, log_path))


GUEST_AWS_CONFIG_DIR = os.path.dirname(GUEST_AWS_CONFIG_PATH)

PUSH_AWS_CONFIG_SH = (
    'mkdir -p %s && tmp=$(mktemp %s/.aws-config.XXXXXX) && cat >"$tmp" && mv "$tmp" %s'
