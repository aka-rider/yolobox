def main(argv: Sequence[str]) -> int:
    if not argv:
        err(USAGE.rstrip("\n"))
        return 2
    sub, rest = argv[0], list(argv[1:])

    if sub in ("--help", "-h", "help"):
        out(USAGE.rstrip("\n"))
        return 0
    if sub in ("--version", "-V"):
        out("yolobox %s" % YO_VERSION)
        return 0

    command = COMMANDS.get(sub)
    if command is None:
        err(USAGE.rstrip("\n"))
        return 2

    require_tool("limactl", "brew install lima")
    command(rest)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except YoError as failure:
        if failure.message:
            err("yo: %s" % failure.message)
        if failure.show_usage:
            err(USAGE.rstrip("\n"))
        sys.exit(failure.code)
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        os._exit(0)
