def t3_require_service() -> None:
    unit = guest_out(
        ["systemctl", "show", "-p", "LoadState", "-p", "ActiveState", "--value", "t3"],
        check=False,
    ).splitlines()
    load_state = unit[0] if unit else ""
    active_state = unit[1] if len(unit) > 1 else ""
    if not load_state:
        raise YoError("cannot reach the VM to ask about t3 — is it up? (yo status)")
    if load_state != "loaded":
        raise YoError("no t3 unit in the VM's current system — switch it: %s" % rebuild_hint())
    if active_state != "active":
        raise YoError(
            "t3 service is %s in the VM — diagnose with: yo ssh journalctl -u t3 -n 50"
            % active_state
        )
    probe = run(["curl", "-sS", "-o", "/dev/null", "--max-time", "5", "http://127.0.0.1:%d/" % T3_PORT])
    if probe.returncode != 0:
        err("yo: t3 is healthy in the VM but 127.0.0.1:%d does not answer on this Mac —" % T3_PORT)
        err("    lima's port forwarding is dead (see ~/.lima/%s/ha.stderr.log)." % INSTANCE)
        err("    Recover with: limactl stop %s && ./yo up" % INSTANCE)
        raise YoError(None, code=1)


def parse_pairing_url(text: str) -> Optional[str]:
    url = ""
    for line in text.replace("\r", "").splitlines():
        stripped = line.strip()
        if stripped.startswith("Pairing URL:"):
            url = stripped[len("Pairing URL:") :].strip()
            break
    if not url:
        return None
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https") or parsed.hostname not in ("127.0.0.1", "localhost"):
        raise YoError("'t3 pair' printed a pairing URL yo will not open: %s" % url)
    return url


def cmd_t3(args: argparse.Namespace) -> None:
    t3_require_service()
    pair_out = ssh_run(AGENT, ["t3", "pair", "--ttl", "2m", "--label", "yo"], merge_stderr=True).stdout
    url = parse_pairing_url(pair_out)
    if url is None:
        err("yo: 't3 pair' printed no 'Pairing URL:' line:")
        err(pair_out.rstrip("\n"))
        raise YoError(None, code=1)
    exec_process(["open", url])


def cmd_pair(args: argparse.Namespace) -> None:
