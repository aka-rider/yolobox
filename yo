def link_remote_action(existing_url: Optional[str], wanted_url: str) -> str:
    if not existing_url:
        return "add"
    if existing_url == wanted_url:
        return "keep"
    if urllib.parse.urlsplit(existing_url).hostname == VM_HOST:
        return "update"
    raise YoError(
        "remote 'yolobox' points at %s, which is not this VM — "
        "run \"git remote remove yolobox\" or fix it by hand" % existing_url
    )


def cmd_link(args: argparse.Namespace) -> None:
    require_agent_account()
    cdup = run(["git", "rev-parse", "--show-cdup"])
    if cdup.returncode != 0:
        raise YoError("link must run inside a git repo")
    toplevel = os.path.normpath(os.path.join(logical_cwd(), cdup.stdout.strip()))

    if toplevel == home():
        raise YoError("refusing to link $HOME itself")
    vmdir = mirror(toplevel)
    if vmdir is None:
        raise YoError("repo must be under $HOME (it is at %s)" % toplevel)
    vmdir = guest_path(vmdir)
    url = "ssh://%s@%s%s" % (AGENT_USER, VM_HOST, vmdir)

    probe = run(["git", "-C", toplevel, "remote", "get-url", "yolobox"])
    existing = probe.stdout.strip() if probe.returncode == 0 else None
    action = link_remote_action(existing, url)

    guest_helper_check(guest_helper(AGENT, "ensure-repo", [vmdir]), "ensure-repo")

    if action == "add":
        run(["git", "-C", toplevel, "remote", "add", "yolobox", url], check=True)
    elif action == "update":
        run(["git", "-C", toplevel, "remote", "set-url", "yolobox", url], check=True)
        err("yo: remote 'yolobox' pointed at %s; updated to %s" % (existing, url))
    else:
        err("yo: remote 'yolobox' already points at %s" % url)
    run(
        [
            "git",
            "-C",
            toplevel,
            "config",
            "remote.yolobox.sshCommand",
            shlex.join(["ssh", "-F", ssh_cfg(), "-o", "ControlPath=none"]),
        ],
        check=True,
    )


def tar_stream(members: Sequence[Tuple[str, str]]) -> bytes:
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w") as archive:
        for path, arcname in members:
            archive.add(path, arcname=arcname, recursive=False)
    return buffer.getvalue()


SEED_STRIP_RE = re.compile(r"^\s*(Include|IdentityAgent)\s", re.IGNORECASE)


def seed_ssh(report: Report) -> None:
    config_path = os.path.join(home(), ".ssh", "config")
    try:
        with open(config_path, "r", errors="replace") as handle:
            lines = handle.read().splitlines(True)
    except OSError:
        report.ok("no ~/.ssh/config on this Mac — skipped")
    else:
        filtered = "".join(line for line in lines if not SEED_STRIP_RE.search(line))
        ssh_run(
            AGENT,
            ["sh", "-c", SEED_SSH_CONFIG],
            stdin=filtered.encode(),
            mux=True,
            capture=False,
            check=True,
        )

    ssh_dir = Path(home()) / ".ssh"
    pubkeys = sorted(str(p) for p in ssh_dir.glob("*.pub") if p.is_file())
    if not pubkeys:
        return
    members = [(path, os.path.basename(path)) for path in pubkeys]
    ssh_run(
        AGENT,
        ["sh", "-c", SEED_UNTAR_SSH],
        stdin=tar_stream(members),
        mux=True,
        capture=False,
        check=True,
    )


def seed_gitconfig() -> None:
    roots = agent_paths("home-roots")
    members = []
    for root in roots:
        if not root or "/" in root or root in (".", ".."):
            continue
        root_path = Path(home()) / root
        if not root_path.is_dir():
            continue
        for identity in sorted(root_path.glob("*/.gitconfig")):
            if identity.is_file():
                members.append((str(identity), str(identity.relative_to(home()))))
    if not members:
        return
    ssh_run(
        AGENT,
        ["sh", "-c", SEED_UNTAR_HOME],
        stdin=tar_stream(members),
        mux=True,
        capture=False,
        check=True,
    )


def seed_all() -> None:
    require_agent_account()
    seed_ssh(Report())
    seed_gitconfig()


def cmd_seed(args: argparse.Namespace) -> None:
    seed_all()


def guest_field(text: str, key: str) -> str:
    fields = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)
    return fields.get(key, "")


def cmd_aws_check(args: argparse.Namespace) -> None:
    report = Report()

    profile = os.environ.get("YOLOBOX_AWS_PROFILE", "")
    if not profile:
        raise report.abort(
            "YOLOBOX_AWS_PROFILE is not set",
            "Set it to a host AWS CLI profile and rerun: YOLOBOX_AWS_PROFILE=<profile> ./yo aws-check",
        )
    if shutil.which("aws") is None:
        raise report.abort("'aws' is not on this Mac's PATH")
    report.ok("aws is on this Mac's PATH")

    creds = run(
        ["aws", "configure", "export-credentials", "--profile", profile, "--format", "process"],
        merge_stderr=True,
    )
    if creds.returncode != 0:
        raise report.abort(
            "'aws configure export-credentials --profile %s' failed:" % profile,
            creds.stdout.strip(),
        )
    try:
        session_token = json.loads(creds.stdout).get("SessionToken") or ""
    except ValueError:
        session_token = ""
    if not session_token:
        raise report.abort(
            "profile '%s' returned no SessionToken — these are long-lived keys" % profile,
            "and must never enter the guest. Point YOLOBOX_AWS_PROFILE at a profile that",
            "yields temporary credentials (role_arn or credential_process), not a static",
            "IAM user profile.",
        )
    report.ok("host export-credentials succeeded for '%s', SessionToken present" % profile)

    region = aws_region(profile)
    report.ok("region resolves to %s" % region)

    broker = start_aws_broker(profile)
    try:
        report.ok(
            "broker started, host port %d forwarded to guest port %d"
            % (broker.host_port, broker.guest_port)
        )

        region_opts, region_env = send_env({"AWS_REGION": region})
        env = dict(os.environ)
        env.update(region_env)
        env.update(broker.env)
        guest_proc = guest_helper(
            AGENT,
            "aws-check",
            extra_opts=list(broker.ssh_opts) + region_opts,
            env=env,
        )
        guest_out_text = guest_proc.stdout + (guest_proc.stderr or "")

        if guest_field(guest_out_text, "ENV_MISSING"):
            report.fail(
                "the guest session never saw AWS_CONTAINER_CREDENTIALS_FULL_URI/AWS_CONTAINER_AUTHORIZATION_TOKEN",
                "Check AcceptEnv in nix/base.nix and that the guest is running the switch that carries it.",
            )

        health = guest_field(guest_out_text, "HEALTH")
        if health == "200":
            report.ok("guest curl to the broker's /health returned 200")
        else:
            report.fail(
                "guest curl to the broker's /health returned '%s', expected 200"
                % (health or "<no response>")
            )

        creds_json = guest_field(guest_out_text, "CREDS")
        try:
            payload = json.loads(creds_json)
        except ValueError:
            payload = {}
        expected = {"AccessKeyId", "SecretAccessKey", "Token", "Expiration"}
        if isinstance(payload, dict) and expected <= set(payload):
            report.ok("guest /creds answers with AccessKeyId, SecretAccessKey, Token and Expiration")
        else:
            report.fail("guest /creds did not answer with all four expected keys", creds_json)

        sts_out = guest_field(guest_out_text, "STS")
        try:
            role_arn = json.loads(sts_out).get("Arn") or ""
        except ValueError:
            role_arn = ""
        if role_arn:
            report.ok("guest sts get-caller-identity answers with %s" % role_arn)
        else:
            report.fail("guest sts get-caller-identity did not return a role ARN:", sts_out)
    finally:
        broker.stop()

    if report.failed:
        raise YoError(None, code=1)


def disk_grow_size(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(
            "disk-grow size must be a whole number of GiB, got '%s'" % value
        )
    if parsed <= 0:
        raise argparse.ArgumentTypeError("disk-grow size must be greater than 0 GiB")
    return parsed


