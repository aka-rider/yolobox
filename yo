def second_line(text: str) -> str:
    lines = text.splitlines()
    return lines[1] if len(lines) > 1 else ""


def du_kib(path: str) -> Optional[int]:
    try:
        return os.stat(path).st_blocks * 512 // 1024
    except OSError:
        return None


TAILSCALE_SERVE_UNIT = "yolobox-tailscale-serve"
TAILSCALE_SERVE_RESTART = "yo ssh sudo systemctl restart %s" % TAILSCALE_SERVE_UNIT
# One operator round trip: tailscale's own JSON, a separator line, then the
# serve unit's state. `command -v` first, so a box predating nix/tailscale.nix
# answers with a marker instead of a bare "not found".
TAILSCALE_PROBE = (
    "command -v tailscale >/dev/null 2>&1 || { echo %s; exit 0; }; "
    "tailscale status --json; echo; echo %s; "
    "systemctl show -p ActiveState --value %s"
) % (shlex.quote("NO_TAILSCALE"), shlex.quote("---"), TAILSCALE_SERVE_UNIT)


def tailscale_status_line(stdout: str, stderr: str) -> str:
    if stdout.strip() == "NO_TAILSCALE":
        return "tailscale: box predates the tailnet module; run `yo bootstrap`"
    status_json, _, serve_state = stdout.partition("\n---\n")
    try:
        backend = json.loads(status_json)["BackendState"]
    except (ValueError, KeyError, TypeError):
        detail = stderr.strip() or status_json.strip() or "no output"
        return "tailscale: WARNING status unreadable: %s" % detail
    serve = serve_state.strip() or "unknown"
    if backend == "Running" and serve == "active":
        return "tailscale: Running, serve active"
    remedy = TAILSCALE_SERVE_RESTART
    if backend != "Running":
        remedy = "yo ssh sudo tailscale up, then: " + remedy
    return "tailscale: WARNING %s, serve %s — fix with: %s" % (backend, serve, remedy)


def status_guest_services() -> None:
    guest_version_raw = guest_out(["cat", "/etc/yolobox/version"], check=False).strip()
    guest_version = guest_version_raw or None
    unknown_note = "unknown (box built before /etc/yolobox/version existed)"
    out("yolobox: host yo %s, box built by %s" % (YO_VERSION, guest_version or unknown_note))
    drift = version_drift(YO_VERSION, guest_version)
    if drift:
        err(drift)

    if vm_units_present():
        op_probe = ssh_run(AGENT, ["ssh-add", "-l"], check=False)
        out("1password: guest forward is %s" % ("up" if op_probe_alive(op_probe) else "down"))

        for unit in PROXY_SOCKET_UNITS:
            state = ssh_run(
                OPERATOR, ["systemctl", "show", "-p", "ActiveState", "--value", unit], check=False
            ).stdout.strip()
            out("proxy: %s is %s" % (unit, state or "unknown"))
    else:
        out("yo: %s" % UNITS_MISSING_NOTE)

    tailscale_probe = ssh_run(OPERATOR, ["sh", "-c", TAILSCALE_PROBE], check=False)
    out(tailscale_status_line(tailscale_probe.stdout, tailscale_probe.stderr))

    t3_problem = t3_service_problem(*t3_unit_state())
    out("t3: %s" % ("WARNING " + t3_problem if t3_problem else "active"))


def cmd_status(args: argparse.Namespace) -> None:
    run(["limactl", "list", INSTANCE], capture=False)

    # Every guest probe below fails the same way on a VM that is down, so ask
    # once and say it once instead of printing a warning per probe.
    status, detail = account_status()
    vm_reachable = status != "unreachable"
    if not vm_reachable:
        if detail:
            err(detail)
        out("vm: unreachable — is it up? start it with: yo up")

    guest_df = second_line(guest_out(["df", "-h", "/"], check=False)) if vm_reachable else ""
    if guest_df:
        out("disk: guest %s" % guest_df)
        fields = guest_df.split()
        use_pct = fields[4].rstrip("%") if len(fields) > 4 else ""
        if use_pct.isdigit() and int(use_pct) >= 90:
            out(
                "disk: WARNING guest / is %s%% full — reclaim with: yo gc --deep --yes, or raise the ceiling with: yo disk-grow <GiB>"
                % use_pct
            )
    image_kib = du_kib(os.path.join(lima_dir(), "disk"))
    if image_kib is not None:
        out(
            "disk: image ~/.lima/%s/disk allocates %dGiB on this host"
            % (INSTANCE, image_kib // 1024 // 1024)
        )

    if vm_reachable:
        status_guest_services()

    gaps = lima_config_gaps()
    if gaps:
        out("lima: %s" % lima_config_gap_message(gaps))
    else:
        out("lima: reverse forwards ok")

    if shutil.which("aws") is None:
        out("aws: disabled (no 'aws' CLI or no SSO profiles in ~/.aws/config)")
    else:
        try:
            allowed = aws_allowlist()
        except YoError as failure:
            out("aws: config unreadable: %s" % failure.message)
        else:
            if not allowed:
                out("aws: disabled (no 'aws' CLI or no SSO profiles in ~/.aws/config)")
            elif not vm_reachable:
                out("aws: guest forward not checked (VM unreachable)")
            else:
                aws_forward_probe = ssh_run(
                    AGENT,
                    ["curl", "-sS", "--unix-socket", AGENT_AWS_BROKER_SOCK, "http://broker/health"],
                    check=False,
                )
                out(
                    "aws: guest forward is %s"
                    % ("up" if aws_forward_probe.returncode == 0 else "down")
                )

                pid = ha_pid()
                health = aws_broker_health()
                if health is None:
                    out("aws: broker not reachable on this Mac's %s" % aws_broker_sock())
                elif pid is not None and health.get("watch_pid") == pid:
                    out("aws: broker healthy (watching hostagent pid %s)" % pid)
                else:
                    out(
                        "aws: broker running but stale (watching pid %s, current hostagent pid %s)"
                        % (health.get("watch_pid"), pid)
                    )


def version_drift(host: str, guest: Optional[str]) -> Optional[str]:
    if guest is None or host == "dev" or host == guest:
        return None
    return (
        "yo: this host's yo is %s but the box was built by %s — rebuild it: yo bootstrap"
        % (host, guest)
    )


def flake_ref() -> str:
    override = os.environ.get("YOLOBOX_FLAKE")
    if override:
        return override
    if YO_VERSION == "dev":
        raise YoError(
            "this is an unreleased build with no pinned flake — set YOLOBOX_FLAKE to what the VM should build from (e.g. YOLOBOX_FLAKE=github:aka-rider/yolobox/my-branch)"
        )
    return "github:aka-rider/yolobox/v%s" % YO_VERSION


def rebuild_hint() -> str:
    try:
        ref = flake_ref()
    except YoError as failure:
        err("yo: %s" % failure.message)
        return "set YOLOBOX_FLAKE to a flake ref the box should build from, then retry"
    return (
        "yo ssh sudo YOLOBOX_USERNAME=$(id -un) nixos-rebuild switch --impure --flake '%s#yolobox'"
        % ref
    )


def helper_skew(what: str) -> str:
    guest_version = guest_out(["cat", "/etc/yolobox/version"], check=False).strip() or None
    drift = version_drift(YO_VERSION, guest_version)
    if drift:
        return "%s.\n    %s" % (what, drift[len("yo: ") :])
    return "%s.\n    rebuild it: %s" % (what, rebuild_hint())


def host_user() -> str:
    return pwd.getpwuid(os.getuid()).pw_name


def guest_generations() -> Tuple[str, str]:
    proc = guest_helper(OPERATOR, "generations")
    return guest_field(proc.stdout, "profile"), guest_field(proc.stdout, "booted")


def cmd_bootstrap(args: argparse.Namespace) -> None:
    report = Report()
    ref = flake_ref()

    vm_up(run_services=False)
    report.ok("VM up")

    require_operator_uid()
    report.ok("operator is uid %s" % OPERATOR_UID)

    ssh_run(
        OPERATOR,
        [
            "sudo",
            "YOLOBOX_USERNAME=%s" % host_user(),
            "nixos-rebuild",
            "boot",
            "--impure",
            "--flake",
            "%s#yolobox" % ref,
        ],
        mux=True,
        capture=False,
        check=True,
        inherit_stdin=True,
    )
    report.ok("built from %s" % ref)

    profile, booted = guest_generations()
    if not booted:
        raise report.abort("cannot read the VM's generations — is it up? (yo status)")
    if profile == booted:
        report.ok("already running the built generation")
    else:
        run(["limactl", "restart", INSTANCE], capture=False, check=True)
        profile, booted = guest_generations()
        if not booted:
            raise report.abort("cannot read the VM's generations — is it up? (yo status)")
        if profile != booted:
            raise report.abort(
                "the VM rebooted but is still not running the built generation",
                "profile: %s" % profile,
                "booted:  %s" % booted,
                "Check df /boot in the VM — a half-failed bootloader install leaves the two",
                "generations disagreeing (see CLAUDE.md).",
            )
        report.ok("rebooted into the built generation")

    seed_all()
    report.ok("seeded")

