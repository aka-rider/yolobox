def out(line: str = "") -> None:
    print(line, flush=True)


def err(line: str = "") -> None:
    print(line, file=sys.stderr, flush=True)


class Report:
    def __init__(self) -> None:
        self.failed = False

    def ok(self, message: str) -> None:
        out("ok:   %s" % message)

    def fail(self, message: str, *remedies: str) -> None:
        self.failed = True
        err("FAIL: %s" % message)
        for remedy in remedies:
            err("      %s" % remedy)

    def abort(self, message: str, *remedies: str) -> "YoError":
        self.fail(message, *remedies)
        return YoError(None, code=1)


def require_tool(name: str, hint: str) -> str:
    path = shutil.which(name)
    if path is None:
        raise YoError("%s not found (%s)" % (name, hint))
    return path


def run(
    argv: Sequence[str],
    *,
    capture: bool = True,
    check: bool = False,
    stdin: Optional[bytes] = None,
    env: Optional[Dict[str, str]] = None,
    merge_stderr: bool = False,
    binary: bool = False,
) -> subprocess.CompletedProcess:
    proc = subprocess.run(
        list(argv),
        input=stdin,
        stdout=subprocess.PIPE if capture else None,
        stderr=(subprocess.STDOUT if merge_stderr else subprocess.PIPE) if capture else None,
        env=env,
    )
    if capture:
        proc.stdout = proc.stdout or b""
        if not binary:
            proc.stdout = proc.stdout.decode("utf-8", "replace").replace("\r", "")
        if proc.stderr is not None:
            proc.stderr = proc.stderr.decode("utf-8", "replace").replace("\r", "")
    if check and proc.returncode != 0:
        if capture:
            stdout_text = proc.stdout.decode("utf-8", "replace") if binary else proc.stdout
            detail = (proc.stderr or stdout_text or "").strip()
        else:
            detail = ""
        raise YoError(
            "%s failed (exit %d)%s" % (shlex.join(argv), proc.returncode, ": " + detail if detail else "")
        )
    return proc


def exec_process(argv: Sequence[str], env: Optional[Dict[str, str]] = None) -> None:
    # CPython starts with SIGPIPE ignored and exec preserves an ignored
    # disposition, so a pipeline reader that exits would leave the exec'd
    # process seeing EPIPE instead of dying, unlike bash's `exec ssh`.
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    os.execvpe(argv[0], list(argv), env if env is not None else os.environ)


@dataclass(frozen=True)
class SshRole:
    user: Optional[str]
    own_control_path: bool


OPERATOR = SshRole(None, False)
AGENT = SshRole(AGENT_USER, True)


def ssh_base(role: SshRole, mux: bool = False) -> List[str]:
    ensure_agent_ssh_config()
    argv = ["ssh", "-F", ssh_cfg()]
    if role.user is not None:
        argv += ["-o", "User=%s" % role.user]
    if not mux:
        argv += ["-o", "ControlPath=none"]
    elif role.own_control_path:
        argv += ["-o", "ControlPath=%s" % agent_control_path()]
    return argv


def remote(argv: Sequence[str]) -> str:
    return shlex.join(argv)


def forward_agent_opts() -> List[str]:
    return ["-o", 'ForwardAgent="%s"' % op_sock()]


def send_env(values: Dict[str, str]) -> Tuple[List[str], Dict[str, str]]:
    for name in values:
        if name not in FORWARDED_ENV:
            raise YoError(
                "internal error: %s is not in the guest's AcceptEnv whitelist" % name
            )
    env = dict(os.environ)
    env.update(values)
    return ["-o", "SendEnv=" + " ".join(values)], env


def ssh_run(
    role: SshRole,
    argv: Sequence[str],
    *,
    stdin: Optional[bytes] = None,
    extra_opts: Sequence[str] = (),
    env: Optional[Dict[str, str]] = None,
    mux: bool = False,
    capture: bool = True,
    check: bool = False,
    merge_stderr: bool = False,
    inherit_stdin: bool = False,
    binary: bool = False,
) -> subprocess.CompletedProcess:
    cmd = ssh_base(role, mux=mux) + list(extra_opts)
    if stdin is None and not inherit_stdin:
        cmd.append("-n")
    cmd += [VM_HOST, remote(argv)]
    return run(
        cmd,
        capture=capture,
        check=check,
        stdin=stdin,
        env=env,
        merge_stderr=merge_stderr,
        binary=binary,
    )


def guest_out(argv: Sequence[str], *, check: bool = True, mux: bool = False) -> str:
    return ssh_run(OPERATOR, argv, mux=mux, check=check).stdout


def agent_out(argv: Sequence[str], *, check: bool = True, mux: bool = False) -> str:
    return ssh_run(AGENT, argv, mux=mux, check=check).stdout


def agent_paths(argv: Sequence[str]) -> List[str]:
    proc = ssh_run(AGENT, argv, check=True, binary=True)
    decoded = proc.stdout.decode("utf-8", "replace")
    return [entry for entry in decoded.split("\0") if entry]


def require_agent_account() -> None:
    probe = ssh_run(AGENT, ["true"])
    if probe.returncode == 0:
        return
    if ssh_run(OPERATOR, ["true"]).returncode == 0:
        err("yo: cannot ssh into %s as '%s'." % (INSTANCE, AGENT_USER))
        err("    Every AI session runs as that account, and this VM has no working one —")
        err("    it predates the operator/agent split. Rebuild it:")
        err("        limactl delete %s && yo bootstrap" % INSTANCE)
    else:
        err(probe.stderr.rstrip("\n"))
        err("yo: cannot reach %s as operator either — is the VM up? yo status" % INSTANCE)
    raise YoError(None, code=1)


def guest_path(path: str) -> str:
    if "\0" in path or "\n" in path:
        raise YoError("refusing a guest path with a newline or NUL byte")
    normalised = os.path.normpath(path)
    if normalised != AGENT_HOME and not normalised.startswith(AGENT_HOME + "/"):
        raise YoError(
            'refusing to target "%s": no yo command may leave the guest home "%s"'
            % (path, AGENT_HOME)
        )
    return normalised


def logical_cwd() -> str:
    pwd_env = os.environ.get("PWD", "")
    if os.path.isabs(pwd_env):
        try:
            if os.path.samefile(pwd_env, os.getcwd()):
                return pwd_env
        except OSError:
            pass
    return os.getcwd()


def mirror(mac_path: str) -> Optional[str]:
    host = home()
    if mac_path == host:
        return AGENT_HOME
    if mac_path.startswith(host + "/"):
        return AGENT_HOME + "/" + mac_path[len(host) + 1 :]
    return None


ANCESTOR_WALK = r"""d="$1"
while [ -n "$d" ] && [ ! -d "$d" ]; do d="${d%/*}"; done
printf '%s\n' "${d:-$HOME}"
"""

PROJECT_FIND = r"""find "$HOME" -mindepth 2 -maxdepth 5 \( -name ".*" ! -name .git \) -prune -o -name .git \( -type d -o -type f \) -printf "%h\0"
"""

GITCONFIG_ROOTS_FIND = r"""find "$HOME" -mindepth 1 -maxdepth 1 -type d ! -name ".*" -printf "%f\0"
"""

ENSURE_REPO = r"""mkdir -p "$1" && { git -C "$1" rev-parse --git-dir >/dev/null 2>&1 || { git -C "$1" init -b main && git -C "$1" config receive.denyCurrentBranch updateInstead; }; }
"""

SEED_SSH_CONFIG = r"""mkdir -p ~/.ssh && chmod 700 ~/.ssh && cat >~/.ssh/config && chmod 600 ~/.ssh/config"""

SEED_UNTAR_SSH = r"""tar -C "$HOME/.ssh" -xf -"""

SEED_UNTAR_HOME = r"""tar -C "$HOME" -xf -"""

MISSING_PATH_NOTE = 'path "%s" does not exist in the yolobox you are in "%s"'


def dir_for_cwd() -> str:
    desired = mirror(logical_cwd())
    if desired is None:
        err(MISSING_PATH_NOTE % (logical_cwd(), AGENT_HOME))
        return AGENT_HOME
    landing = agent_out(["sh", "-c", ANCESTOR_WALK, "sh", desired]).strip("\n")
    if landing != desired:
        err(MISSING_PATH_NOTE % (desired, landing))
    return guest_path(landing)


def pick_project(query: str) -> str:
    require_tool("fzf", "brew install fzf")
    listing = agent_paths(["sh", "-c", PROJECT_FIND])
    prefix = AGENT_HOME + "/"
    projects = sorted(
        entry[len(prefix) :] for entry in listing if entry.startswith(prefix)
    )
    if not projects:
        raise YoError("no projects in the VM")
    picker = subprocess.run(
        ["fzf", "--read0", "--print0", "--select-1", "--exit-0", "--query=" + query],
        input="\0".join(projects).encode(),
        stdout=subprocess.PIPE,
    )
    if picker.returncode != 0:
        if picker.returncode != 130:
            err("yo: no project matches '%s'" % query)
        raise YoError(None, code=picker.returncode)
    choice = picker.stdout.decode("utf-8", "replace").rstrip("\0")
    return guest_path(AGENT_HOME + "/" + choice)


def target_dir(args: Sequence[str]) -> str:
    if len(args) == 1:
        return pick_project(args[0])
    return dir_for_cwd()


@dataclass(frozen=True)
class HerdForward:
    guest_sock: str
    ssh_opts: List[str]
    env: Dict[str, str]


def herd_forward() -> Optional[HerdForward]:
    if os.environ.get("HERDR_ENV") != "1":
        return None
    pane_id = os.environ.get("HERDR_PANE_ID", "")
    host_sock = os.environ.get("HERDR_SOCKET_PATH", "")
    if not pane_id or not host_sock:
        return None
    try:
        if not stat.S_ISSOCK(os.stat(host_sock).st_mode):
            return None
    except OSError:
        return None
    if ":" in host_sock:
        raise YoError(
            "HERDR_SOCKET_PATH \"%s\" contains a colon, which ssh's -R syntax splits on"
            % host_sock
        )
    guest_sock = "%s/herd-host.%s.sock" % (
        GUEST_SOCK_DIR,
        re.sub(r"[^A-Za-z0-9]", "_", pane_id),
    )
    opts, env = send_env(
        {
            "YOLOBOX_HERD": "1",
            "HERDR_PANE_ID": pane_id,
            "HERDR_SOCKET_PATH": guest_sock,
        }
    )
    return HerdForward(guest_sock, ["-R", "%s:%s" % (guest_sock, host_sock)] + opts, env)


def parse_herd_version(text: str) -> Optional[str]:
    match = re.search(r"(\d+\.\d+\.\d+)", text.replace("\r", ""))
    return match.group(1) if match else None


@dataclass(frozen=True)
class GuestHerd:
    generation: str
    version: str
    prev_generation: str
    prev_version: str


def guest_herd_version() -> Optional[GuestHerd]:
    prev_generation = ""
    prev_version = ""
    try:
        with open(herd_version_cache(), "r") as handle:
            fields = handle.readline().split()
        if len(fields) >= 2:
            prev_generation, prev_version = fields[0], fields[1]
    except OSError:
        pass

    probe = ssh_run(
        OPERATOR, ["sh", "-c", "readlink /run/current-system && herdr --version"], mux=True
    )
    if probe.returncode != 0:
        return None
    lines = probe.stdout.splitlines()
    if not lines:
        return None
    generation = lines[0]
    version = parse_herd_version(lines[1]) if len(lines) > 1 else None
    if not version:
        return None
    os.makedirs(state_dir(), exist_ok=True)
    with open(herd_version_cache(), "w") as handle:
        handle.write("%s %s\n" % (generation, version))
    return GuestHerd(generation, version, prev_generation, prev_version)


def host_herd_version() -> Optional[str]:
    if shutil.which("herdr") is None:
        return None
    probe = run(["herdr", "--version"])
    if probe.returncode != 0:
        return None
    return parse_herd_version(probe.stdout)


def herd_drift_report(host_version: str, guest_version: str) -> None:
    err("yo: herd version drift — this Mac runs herdr %s, the box has %s." % (host_version, guest_version))
    err("    If the wire protocol differs, every in-box agent report is rejected and")
    err("    the box's agents show as unknown in the herd.")
    err("    Fix:  updating nixpkgs now means releasing a new yolobox version (or pointing YOLOBOX_FLAKE at a branch that has one), then nixos-rebuild switch; finally ./yo herd-check")
    err("    Skip: YOLOBOX_SKIP_HERD_CHECK=1 ./yo enter")


def check_herd_drift(refuse: bool) -> None:
    if os.environ.get("YOLOBOX_SKIP_HERD_CHECK") == "1":
        return
    if shutil.which("herdr") is None:
        return
    if os.environ.get("HERDR_ENV") != "1":
        return
    if not os.environ.get("HERDR_PANE_ID"):
        return
    host_version = host_herd_version()
    if not host_version:
        return
    guest = guest_herd_version()
    if guest is None or host_version == guest.version:
        return
    herd_drift_report(host_version, guest.version)
    if refuse:
        raise YoError(None, code=3)


@dataclass
class AwsBroker:
    proc: subprocess.Popen
    host_port: int
    guest_port: int
    token: str
    ssh_opts: List[str]
    env: Dict[str, str]

    def stop(self) -> None:
        if self.proc.poll() is None:
            self.proc.terminate()
        try:
            self.proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.proc.kill()


def require_aws_cli() -> None:
    if shutil.which("aws") is None:
        raise YoError("YOLOBOX_AWS_PROFILE is set but 'aws' is not on this Mac's PATH")


def aws_region(profile: str) -> str:
    require_aws_cli()
    probe = run(["aws", "configure", "get", "region", "--profile", profile])
    region = probe.stdout.strip() if probe.returncode == 0 else ""
    if not region:
        region = os.environ.get("AWS_REGION") or os.environ.get("AWS_DEFAULT_REGION") or ""
    if not region:
        raise YoError(
            "profile '%s' has no region and neither AWS_REGION nor\n"
            "    AWS_DEFAULT_REGION is set on this Mac. The guest CLI would target\n"
            "    global endpoints, which this Mac's DNS sinkholes. Add 'region = ...'\n"
            "    to the profile in ~/.aws/config." % profile
        )
    return region


def read_handshake(proc: subprocess.Popen, deadline: float) -> List[str]:
    fd = proc.stdout.fileno()
    buffer = b""
    while buffer.count(b"\n") < 2:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        ready, _, _ = select.select([fd], [], [], remaining)
        if not ready:
            break
        chunk = os.read(fd, 4096)
        if not chunk:
            break
        buffer += chunk
        if buffer.startswith(b"ERROR=") and b"\n" in buffer:
            break
    return buffer.decode("utf-8", "replace").splitlines()


def start_aws_broker(profile: str) -> AwsBroker:
    require_aws_cli()
    log_dir = os.path.join(state_dir(), "aws-broker")
    os.makedirs(log_dir, exist_ok=True)
    log_path = os.path.join(log_dir, "%d.log" % os.getpid())

    # --watch-pid must name the pid that exec becomes ssh, so the broker dies
    # exactly when this session does; exec_process keeps that pid.
    with open(log_path, "wb") as log:
        proc = subprocess.Popen(
            [
                str(SCRIPT_DIR / "aws-broker"),
                "--profile",
                profile,
                "--watch-pid",
                str(os.getpid()),
            ],
            stdout=subprocess.PIPE,
            stderr=log,
            bufsize=0,
        )

    lines = read_handshake(proc, time.monotonic() + 30)
    token = ""
    port = ""
    for line in lines:
        if line.startswith("ERROR="):
            proc.terminate()
            proc.wait()
            raise YoError("aws-broker failed: %s" % line[len("ERROR=") :])
        if line.startswith("TOKEN="):
            token = line[len("TOKEN=") :]
        elif line.startswith("PORT="):
            port = line[len("PORT=") :]
    if not token or not port:
        proc.terminate()
        proc.wait()
        raise YoError("aws-broker produced no handshake within 30s — see %s" % log_path)
    host_port = int(port)

    probe_err = ""
    guest_port = 0
    for _ in range(5):
        candidate = random.randrange(41000, 42000)
        probe = ssh_run(
            AGENT,
            ["true"],
            extra_opts=[
                "-o",
                "ExitOnForwardFailure=yes",
                "-R",
                "127.0.0.1:%d:127.0.0.1:%d" % (candidate, host_port),
            ],
        )
        if probe.returncode == 0:
            guest_port = candidate
            break
        probe_err = probe.stderr
    if not guest_port:
        proc.terminate()
        proc.wait()
        raise YoError(
            "could not claim a guest port for the aws-broker forward after 5 tries:\n%s"
            % probe_err.rstrip("\n")
        )

    opts, env = send_env(
        {
            "AWS_CONTAINER_CREDENTIALS_FULL_URI": "http://127.0.0.1:%d/creds" % guest_port,
            "AWS_CONTAINER_AUTHORIZATION_TOKEN": token,
        }
    )
    ssh_opts = ["-R", "127.0.0.1:%d:127.0.0.1:%d" % (guest_port, host_port)] + opts
    return AwsBroker(proc, host_port, guest_port, token, ssh_opts, env)


GC_COMMON = r"""set -uo pipefail

GC_FAILED=0

ok() {
    printf 'ok:   %s\n' "$1"
}

fail() {
    GC_FAILED=1
    printf 'FAIL: %s\n' "$1" >&2
    shift
    for remedy in "$@"; do
        printf '      %s\n' "${remedy}" >&2
    done
}

# A cleanup step that legitimately finds nothing to do still exits nonzero
# (podman does), and that must not cancel the steps after it — so no `set -e`
# here. Nothing is hidden either: a failure prints, and decides the final exit.
# stdin comes from /dev/null because this whole script is being read from the
# ssh channel's stdin, which a curious child would otherwise eat.
step() {
    label="$1"
    shift
    if "$@" </dev/null; then
        ok "${label}"
    else
        rc=$?
        fail "${label} (exit ${rc})"
    fi
}

# MEASURE_AS is set by the tier script below before this is ever called:
# "sudo" in the machine tier, empty in the user tier.
measure() {
    # -x, because a bind mount of the same device would otherwise be counted
    # twice.
    if [ -n "${MEASURE_AS}" ]; then
        # sudo also for the existence test: /root is mode 700, so an
        # unprivileged -e on /root/.cache/nix says "absent" about a path
        # that is really there.
        sudo test -e "$1" || return 0
        size="$(sudo du -x -s -h "$1" 2>/dev/null | awk '{print $1}')"
    else
        test -e "$1" || return 0
        size="$(du -x -s -h "$1" 2>/dev/null | awk '{print $1}')"
    fi
    printf '  %-7s %s\n' "${size:-?}" "$1"
}
"""

GC_MACHINE = GC_COMMON + r"""
MEASURE_AS=sudo
MACHINE_PATHS="/var/log/journal /nix/store /root/.cache/nix"

if [ "${YO_GC_APPLY}" != 1 ]; then
    printf 'yo gc: report only, nothing is deleted. Add --yes to act.\n\n'
    df -h /
    printf '\nmachine tier (current size of each target):\n'
    for path in ${MACHINE_PATHS}; do
        measure "${path}"
    done
    exit 0
fi

printf 'before:\n'
df -h /
printf '\n'

# Root-only steps first, and that ordering is the point: ext4's reserve is
# root's alone, so on a full disk the agent's unprivileged steps cannot even
# write their own logs until these have freed something. --rotate before
# --vacuum-size because vacuuming only ever unlinks archived journals; without
# the rotation the active file — usually most of the 630M — is untouchable.
step 'journalctl --rotate --vacuum-size=50M' sudo journalctl --rotate --vacuum-size=50M

# A nixos-rebuild that ran out of space on the ESP advances the system profile
# and then dies installing the bootloader, leaving the booted generation and
# the profile pointing at different closures (see CLAUDE.md). `-d` deletes
# every generation but the profile's, which in that state is the one that is
# *not* running — the box would lose its own booted system.
booted="$(readlink -f /run/current-system)"
profile="$(readlink -f /nix/var/nix/profiles/system)"
if [ -n "${booted}" ] && [ "${booted}" = "${profile}" ]; then
    step 'nix-collect-garbage -d' sudo nix-collect-garbage -d
else
    fail "skipped nix-collect-garbage -d: booted and profile generations disagree" \
        "booted:  ${booted:-<unreadable>}" \
        "profile: ${profile:-<unreadable>}" \
        "A nixos-rebuild switch half-failed (check df /boot). Re-run the switch" \
        "until both agree, then ./yo gc --yes again."
fi

# Outside that guard on purpose: this is nix's download cache, tied to no
# generation, so it is safe to drop even when the profile is in the broken
# state above — and that is exactly when the space is most needed.
step 'rm -rf /root/.cache/nix' sudo rm -rf /root/.cache/nix

[ "${GC_FAILED}" = 0 ] || exit 1
"""

GC_USER = GC_COMMON + r"""
MEASURE_AS=

# Hidden directories are pruned in the first branch — except .next, which
# is itself a wanted match — so the walk cannot reach a target/ or
# node_modules/ living inside .git, .devbox or .venv: .venv backs the
# per-project basedpyright (nix/lsp.nix) and .devbox holds devbox's
# toolchain state — neither is build output. Matching directories are
# pruned in turn, so nothing nested inside a hit is walked or reported
# twice.
project_targets() {
    find "$HOME" -mindepth 1 \
        \( -name ".*" ! -name .next \) -prune -o \
        \( -name target -o -name node_modules -o -name .next \) \
        -type d -prune -print0 2>/dev/null
}

USER_PATHS="$HOME/.npm $HOME/.local/share/containers/storage"

if [ "${YO_GC_APPLY}" != 1 ]; then
    printf 'user tier (current size of each target):\n'
    for path in ${USER_PATHS}; do
        measure "${path}"
    done
    if [ "${YO_GC_DEEP}" = 1 ]; then
        printf '\nproject tier (--deep):\n'
        found=0
        while IFS= read -r -d '' target; do
            found=1
            measure "${target}"
        done < <(project_targets)
        [ "${found}" = 1 ] || printf '  (none)\n'
    else
        printf '\nproject tier not measured; add --deep to include it.\n'
    fi
    exit 0
fi

step 'npm cache clean --force' npm cache clean --force
# -f only: dangling containers, networks and build cache. Unused *images* need
# a registry pull to come back, which is not regenerable offline, so they wait
# for --deep. nix/podman.nix already runs a periodic autoPrune besides.
step 'podman system prune -f' podman system prune -f

if [ "${YO_GC_DEEP}" = 1 ]; then
    step 'podman system prune -af' podman system prune -af
    while IFS= read -r -d '' target; do
        # Deleting a path git does not ignore dirties the VM worktree, and
        # receive.denyCurrentBranch=updateInstead then refuses every later
        # `git push yolobox` — a breakage that surfaces much later with no
        # link back to here. The name alone does not settle it: an anchored
        # /node_modules in .gitignore leaves a nested one tracked.
        if git -C "$(dirname "${target}")" check-ignore -q "${target}" 2>/dev/null; then
            step "rm -rf ${target}" rm -rf "${target}"
        else
            fail "kept ${target}: git does not ignore it" \
                "Deleting it would dirty the worktree and block every later" \
                "push to the yolobox remote. Add it to that repo's .gitignore" \
                "(or remove it by hand and commit) if it really is build output."
        fi
    done < <(project_targets)
fi

printf '\nafter:\n'
df -h /

[ "${GC_FAILED}" = 0 ] || exit 1
"""

GUEST_AWS_CHECK = r"""set -u
url="${AWS_CONTAINER_CREDENTIALS_FULL_URI:-}"
token="${AWS_CONTAINER_AUTHORIZATION_TOKEN:-}"
if [ -z "${url}" ] || [ -z "${token}" ]; then
    printf 'ENV_MISSING=1\n'
    exit 0
fi
health_url="${url%/creds}/health"
health="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 "${health_url}")"
printf 'HEALTH=%s\n' "${health}"
creds="$(curl -sS -H "Authorization: ${token}" --max-time 5 "${url}")"
printf 'CREDS=%s\n' "${creds}"
sts="$(aws sts get-caller-identity 2>&1)"
printf 'STS=%s\n' "${sts}"
"""


def cmd_up(args: Sequence[str]) -> None:
    listing = run(["limactl", "list", "-q"]).stdout.splitlines()
    if INSTANCE in listing:
        run(["limactl", "start", "--yes", INSTANCE], capture=False, check=True)
    else:
        run(
            [
                "limactl",
                "start",
                "--name",
                INSTANCE,
                "--yes",
                str(SCRIPT_DIR / "lima" / "yolobox.yaml"),
            ],
            capture=False,
            check=True,
        )
    ensure_agent_ssh_config()


def cmd_down(args: Sequence[str]) -> None:
    run(["limactl", "stop", INSTANCE], capture=False, check=True)


def second_line(text: str) -> str:
    lines = text.splitlines()
    return lines[1] if len(lines) > 1 else ""


def du_kib(path: str) -> Optional[int]:
    probe = run(["du", "-k", path])
    if probe.returncode != 0:
        return None
    fields = probe.stdout.split()
    return int(fields[0]) if fields and fields[0].isdigit() else None


def cmd_status(args: Sequence[str]) -> None:
    run(["limactl", "list", INSTANCE], capture=False)

    guest_df = second_line(guest_out(["df", "-h", "/"], check=False))
    if guest_df:
        out("disk: guest %s" % guest_df)
        fields = guest_df.split()
        use_pct = fields[4].rstrip("%") if len(fields) > 4 else ""
        if use_pct.isdigit() and int(use_pct) >= 90:
            out(
                "disk: WARNING guest / is %s%% full — reclaim with: yo gc --deep --yes, or raise the ceiling with: yo disk-grow <GiB>"
                % use_pct
            )
    image_kib = du_kib(os.path.join(lima_dir(), "disk"))
    if image_kib is not None:
        out(
            "disk: image ~/.lima/%s/disk allocates %dGiB on this Mac"
            % (INSTANCE, image_kib // 1024 // 1024)
        )

    check_herd_drift(refuse=False)

    guest_version_raw = guest_out(["cat", "/etc/yolobox/version"], check=False).strip()
    guest_version = guest_version_raw or None
    unknown_note = "unknown (box built before /etc/yolobox/version existed)"
    out("yolobox: host yo %s, box built by %s" % (YO_VERSION, guest_version or unknown_note))
    drift = version_drift(YO_VERSION, guest_version)
    if drift:
        err(drift)


def version_drift(host: str, guest: Optional[str]) -> Optional[str]:
    if guest is None or host == "dev" or host == guest:
        return None
    return (
        "yo: this Mac's yo is %s but the box was built by %s — rebuild it: yo bootstrap"
        % (host, guest)
    )


def flake_ref() -> str:
    override = os.environ.get("YOLOBOX_FLAKE")
    if override:
        return override
    if YO_VERSION == "dev":
        raise YoError(
            "this is an unreleased build with no pinned flake — set YOLOBOX_FLAKE to what the VM should build from (e.g. YOLOBOX_FLAKE=github:aka-rider/yolobox/my-branch)"
        )
    return "github:aka-rider/yolobox/v%s" % YO_VERSION


def rebuild_hint() -> str:
    try:
        ref = flake_ref()
    except YoError as failure:
        err("yo: %s" % failure.message)
        return "set YOLOBOX_FLAKE to a flake ref the box should build from, then retry"
    return (
        "yo ssh sudo YOLOBOX_USERNAME=$(id -un) nixos-rebuild switch --impure --flake '%s#yolobox'"
        % ref
    )


def host_user() -> str:
    return pwd.getpwuid(os.getuid()).pw_name


def guest_generations() -> Tuple[str, str]:
    probe = guest_out(
        ["sh", "-c", "readlink -f /nix/var/nix/profiles/system && readlink -f /run/current-system"],
        check=False,
    )
    lines = probe.splitlines()
    profile = lines[0] if lines else ""
    booted = lines[1] if len(lines) > 1 else ""
    return profile, booted


def cmd_bootstrap(args: Sequence[str]) -> None:
    if args:
        raise usage_error("bootstrap takes no arguments")

    report = Report()
    ref = flake_ref()

    cmd_up([])
    report.ok("VM up")

    ssh_run(
        OPERATOR,
        [
            "sudo",
            "YOLOBOX_USERNAME=%s" % host_user(),
            "nixos-rebuild",
            "boot",
            "--impure",
            "--flake",
            "%s#yolobox" % ref,
        ],
        mux=True,
        capture=False,
        check=True,
        inherit_stdin=True,
    )
    report.ok("built from %s" % ref)

    profile, booted = guest_generations()
    if not booted:
        raise report.abort("cannot read the VM's generations — is it up? (yo status)")
    if profile == booted:
        report.ok("already running the built generation")
    else:
        run(["limactl", "restart", INSTANCE], capture=False, check=True)
        profile, booted = guest_generations()
        if not booted:
            raise report.abort("cannot read the VM's generations — is it up? (yo status)")
        if profile != booted:
            raise report.abort(
                "the VM rebooted but is still not running the built generation",
                "profile: %s" % profile,
                "booted:  %s" % booted,
                "Check df /boot in the VM — a half-failed bootloader install leaves the two",
                "generations disagreeing (see CLAUDE.md).",
            )
        report.ok("rebooted into the built generation")

    cmd_seed([])
    report.ok("seeded")

    ensure_ssh_config_include(refuse=False)


def cmd_gc(args: Sequence[str]) -> None:
    deep = 0
    apply_now = 0
    for arg in args:
        if arg == "--deep":
            deep = 1
        elif arg == "--yes":
            apply_now = 1
        else:
            raise usage_error("unknown gc option '%s'" % arg)

    env_prefix = ["env", "YO_GC_DEEP=%d" % deep, "YO_GC_APPLY=%d" % apply_now, "bash", "-s"]
    failed = False

    machine = ssh_run(
        OPERATOR, env_prefix, stdin=GC_MACHINE.encode(), mux=True, capture=False
    )
    failed = failed or machine.returncode != 0

    require_agent_account()
    user = ssh_run(AGENT, env_prefix, stdin=GC_USER.encode(), mux=True, capture=False)
    failed = failed or user.returncode != 0

    if failed:
        raise YoError(None, code=1)


def cmd_disk_grow(args: Sequence[str]) -> None:
    if len(args) != 1:
        raise usage_error("disk-grow takes one argument, the new size in GiB")
    if not args[0].isdigit():
        raise YoError(
            "disk-grow size must be a whole number of GiB, got '%s'" % args[0], code=2
        )
    wanted = int(args[0])
    if wanted <= 0:
        raise YoError("disk-grow size must be greater than 0 GiB", code=2)

    probe = run(["limactl", "list", INSTANCE, "--format", "{{.Disk}}"])
    current_bytes = probe.stdout.strip() if probe.returncode == 0 else ""
    if not current_bytes.isdigit():
        raise YoError(
            "limactl reports no disk size for %s — does the instance exist? (yo status)"
            % INSTANCE
        )
    current_gib = int(current_bytes) // 1024 // 1024 // 1024
    if wanted <= current_gib:
        raise YoError(
            "%s's ceiling is already %dGiB and lima can only grow it — ask for more than %d"
            % (INSTANCE, current_gib, current_gib)
        )

    load_state = guest_out(
        ["systemctl", "show", "-p", "LoadState", "--value", "growpart"], check=False
    ).splitlines()
    load_state = load_state[0] if load_state else ""
    if not load_state:
        raise YoError("cannot reach the VM to ask about growpart — is it up? (yo status)")
    if load_state != "loaded":
        raise YoError(
            "no growpart unit in the VM's current system, so growing the ceiling would leave /dev/vda2 untouched — switch it: %s"
            % rebuild_hint()
        )

    df_before = second_line(guest_out(["df", "-h", "/"], check=False))
    blocks_before = df_blocks(guest_out(["df", "-k", "/"], check=False))

    free_kib = df_blocks(run(["df", "-k", os.path.join(home(), ".lima")]).stdout, field=3)
    image_kib = du_kib(os.path.join(lima_dir(), "disk")) or 0
    out(
        "host: ~/.lima has %dGiB free; the disk image allocates %dGiB today"
        % ((free_kib or 0) // 1024 // 1024, image_kib // 1024 // 1024)
    )
    out("lima: raising %s from %dGiB to %dGiB" % (INSTANCE, current_gib, wanted))

    run(["limactl", "stop", INSTANCE], capture=False, check=True)
    resize = run(["limactl", "edit", "--yes", INSTANCE, "--disk", str(wanted)], capture=False)
    if resize.returncode != 0:
        raise YoError(
            "limactl refused the resize and %s is left stopped — start it again with: yo up"
            % INSTANCE
        )
    cmd_up([])

    df_after = second_line(guest_out(["df", "-h", "/"], check=False))
    blocks_after = df_blocks(guest_out(["df", "-k", "/"], check=False))
    vda2_after = guest_out(["lsblk", "-no", "SIZE", "/dev/vda2"], check=False).splitlines()
    out("before: %s" % df_before)
    out("after:  %s" % df_after)
    out("after:  vda2 is %s" % (vda2_after[0] if vda2_after else ""))
    if blocks_after is None or blocks_after <= (blocks_before or 0):
        raise YoError(
            "the ceiling is now %dGiB but the guest root did not grow — diagnose with: yo ssh systemctl status growpart"
            % wanted
        )


def df_blocks(text: str, field: int = 1) -> Optional[int]:
    line = second_line(text)
    fields = line.split()
    if len(fields) > field and fields[field].isdigit():
        return int(fields[field])
    return None


