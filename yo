    AGENT_USER,
    INSTANCE,
)

AGENT_SSH_CONFIG_MARKER = "# yolobox: re-applied by yo; lima rewrites this file on every start"
LIMA_SSH_ALIAS_FIELDS = ("Hostname", "Port", "IdentityFile")

SCRIPT_DIR = Path(__file__).resolve().parent


def home() -> str:
    return os.environ.get("HOME") or pwd.getpwuid(os.getuid()).pw_dir


def lima_dir() -> str:
    return os.path.join(home(), ".lima", INSTANCE)


def ssh_cfg() -> str:
    return os.path.join(lima_dir(), "ssh.config")


def agent_control_path() -> str:
    return os.path.join(lima_dir(), "ssh-agent.sock")


def atomic_write(path: str, content: str, mode: int) -> None:
    fd, tmp_path = tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(content)
        os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
    except Exception:
        os.unlink(tmp_path)
        raise


def parse_lima_ssh_block(text: str, host: str) -> Optional[Dict[str, str]]:
    lines = text.splitlines()
    start = None
    for i, line in enumerate(lines):
        if line.strip() == "Host %s" % host:
            start = i + 1
            break
    if start is None:
        return None
    values: Dict[str, str] = {}
    for line in lines[start:]:
        if line and not line[0].isspace():
            break
        key, _, value = line.strip().partition(" ")
        if key in LIMA_SSH_ALIAS_FIELDS:
            values[key] = value.strip().strip('"')
    if not all(values.get(field) for field in LIMA_SSH_ALIAS_FIELDS):
        return None
    return values


def herdr_alias_block(lima_values: Dict[str, str]) -> str:
    return "\n".join(
        [
            "Host %s" % HERDR_SSH_ALIAS,
            "  User %s" % AGENT_USER,
            # Never share yo's own multiplexed master: OpenSSH's mux client
            # does not re-check a new connection's login user against the
            # master's, so herdr would silently ride an operator session.
            "  ControlPath none",
            "  Hostname %s" % lima_values["Hostname"],
            "  Port %s" % lima_values["Port"],
            '  IdentityFile "%s"' % lima_values["IdentityFile"],
            "  StrictHostKeyChecking no",
            "  UserKnownHostsFile /dev/null",
            "  IdentitiesOnly yes",
        ]
    )


def ensure_agent_ssh_config() -> None:
    path = ssh_cfg()
    try:
        with open(path, "r") as handle:
            current = handle.read()
    except OSError:
        return

    if current.startswith(AGENT_SSH_CONFIG_MARKER):
        _, _, rest = current.partition("\n\n")
    else:
        rest = current

    owned = [AGENT_SSH_CONFIG_MARKER, EDITOR_SSH_BLOCK]
    lima_values = parse_lima_ssh_block(rest, VM_HOST)
    if lima_values is None:
        err(
            "yo: %s has no parseable 'Host %s' block (Hostname/Port/IdentityFile) — "
            "skipping the %r ssh alias herdr needs; run yo up to let lima regenerate it"
            % (path, VM_HOST, HERDR_SSH_ALIAS)
        )
    else:
        owned.append(herdr_alias_block(lima_values))

    new_content = "\n".join(owned) + "\n\n" + rest
    if new_content == current:
        return
    atomic_write(path, new_content, 0o600)


def op_sock() -> str:
