def pairing_label() -> str:
    if sys.platform == "darwin":
        return run(["scutil", "--get", "LocalHostName"], check=True).stdout.strip()
    return socket.gethostname()


def pair_base_url() -> str:
    if sys.platform == "darwin":
        return "http://%s.local:%d" % (pairing_label(), T3_PORT)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
        try:
            probe.connect(("1.1.1.1", 53))
            ip = probe.getsockname()[0]
        except OSError:
            raise YoError(
                "no network route to pick this host's LAN IP for pairing — "
                "pass --base-url http://<ip-or-host>:%d explicitly" % T3_PORT
            )
    err("yo: pairing against %s (this host's primary-route IP) — override with --base-url" % ip)
    return "http://%s:%d" % (ip, T3_PORT)


def tool_hint(name: str) -> str:
    if sys.platform == "darwin":
        brew_names = {"limactl": "lima", "aws": "awscli"}
        return "brew install %s" % brew_names.get(name, name)
    if name in ("limactl", "fzf"):
        return "nix run github:aka-rider/yolobox"
    return "install the %s package for your distro" % name


def require_kvm() -> None:
    if sys.platform != "linux":
        return
    kvm = "/dev/kvm"
    if not os.path.exists(kvm):
        raise YoError(
            "/dev/kvm is missing — enable virtualization in firmware and load the kvm "
            "module; lima would otherwise fall back to unaccelerated QEMU TCG with only "
            "a log warning"
        )
    if not os.access(kvm, os.R_OK | os.W_OK):
        raise YoError(
            "/dev/kvm exists but is not readable/writable by this user — fix its "
            "permissions (e.g. join the kvm group); lima would pass -accel kvm and QEMU "
            "would fail later"
        )


def firewalld_advisory() -> None:
    if sys.platform != "linux":
        return
    if shutil.which("firewall-cmd") is None:
        return
    state = run(["firewall-cmd", "--state"])
    if state.stdout.strip() != "running":
        return
    zones = [
        line
        for line in run(["firewall-cmd", "--get-active-zones"]).stdout.splitlines()
        if line and not line[0].isspace()
    ]
    for zone in zones:
        query = run(["firewall-cmd", "--zone=%s" % zone, "--query-port=%d/tcp" % T3_PORT])
        if query.returncode == 0:
            return
    err(
        "yo: firewalld is running and no active zone opens %d/tcp — a pairing peer on "
        "another device may not reach this URL. Open it with:" % T3_PORT
    )
    err("    sudo firewall-cmd --add-port=%d/tcp" % T3_PORT)


