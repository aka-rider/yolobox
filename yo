def t3_unit_state() -> Tuple[str, str]:
    # t3code is a vendor-installed *user* unit now (nix/t3.nix), not a system
    # one — installed and kept current by yolobox-harness-install, running
    # as the agent from boot (see CLAUDE.md, "The harnesses come from their
    # vendors"). Ask systemd the same question ssh_run(AGENT, ...) always
    # asks it: as the agent, over its own login PAM session, which is what
    # sets XDG_RUNTIME_DIR for a lingering user without a pty.
    unit = ssh_run(
        AGENT,
        ["systemctl", "--user", "show", "-p", "LoadState", "-p", "ActiveState", "--value", "t3code.service"],
        check=False,
    ).stdout.splitlines()
    return (unit[0] if unit else ""), (unit[1] if len(unit) > 1 else "")


def t3_service_problem(load_state: str, active_state: str) -> Optional[str]:
    if not load_state:
        return "cannot reach the VM's agent account to ask about t3code — is it up? (yo status)"
    if load_state != "loaded":
        return (
            "t3code is not installed for the agent yet — its install is a user service: "
            "yo ssh sudo -u agent XDG_RUNTIME_DIR=/run/user/1000 "
            "systemctl --user restart yolobox-harness-install"
        )
    if active_state != "active":
        return (
            "t3code service is %s in the VM — diagnose with: "
            "yo ssh sudo -u agent XDG_RUNTIME_DIR=/run/user/1000 journalctl --user -u t3code -n 50, "
            "or tail ~/.t3/userdata/logs/boot-service.log as the agent" % active_state
        )
    return None


def t3_require_service() -> None:
    problem = t3_service_problem(*t3_unit_state())
    if problem:
        raise YoError(problem)
    probe = run(["curl", "-sS", "-o", "/dev/null", "--max-time", "5", "http://127.0.0.1:%d/" % T3_PORT])
    if probe.returncode != 0:
        err("yo: t3 is healthy in the VM but 127.0.0.1:%d does not answer on this host —" % T3_PORT)
        err("    lima's port forwarding is dead (see ~/.lima/%s/ha.stderr.log)." % INSTANCE)
        err("    Recover with: limactl stop %s && ./yo up" % INSTANCE)
        raise YoError(None, code=1)


def parse_pairing_url(text: str) -> Optional[str]:
    url = ""
    for line in text.replace("\r", "").splitlines():
        stripped = line.strip()
        if stripped.startswith("Pairing URL:"):
            url = stripped[len("Pairing URL:") :].strip()
            break
    if not url:
        return None
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https") or parsed.hostname not in ("127.0.0.1", "localhost"):
        raise YoError("'t3 pair' printed a pairing URL yo will not open: %s" % url)
    return url


