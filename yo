def atomic_write(path: str, content: str, mode: int) -> None:
    fd, tmp_path = tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(content)
        os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
    except Exception:
        os.unlink(tmp_path)
        raise


def parse_lima_ssh_block(text: str, host: str) -> Optional[Dict[str, str]]:
    lines = text.splitlines()
    start = None
    for i, line in enumerate(lines):
        if line.strip() == "Host %s" % host:
            start = i + 1
            break
    if start is None:
        return None
    values: Dict[str, str] = {}
    for line in lines[start:]:
        if line and not line[0].isspace():
            break
        key, _, value = line.strip().partition(" ")
        if key in LIMA_SSH_ALIAS_FIELDS:
            values[key] = value.strip().strip('"')
    if not all(values.get(field) for field in LIMA_SSH_ALIAS_FIELDS):
        return None
    return values


def herdr_alias_block(lima_values: Dict[str, str]) -> str:
    return "\n".join(
        [
            "Host %s" % HERDR_SSH_ALIAS,
            "  User %s" % AGENT_USER,
            # Never share yo's own multiplexed master: OpenSSH's mux client
            # does not re-check a new connection's login user against the
            # master's, so herdr would silently ride an operator session.
            "  ControlPath none",
            "  Hostname %s" % lima_values["Hostname"],
            "  Port %s" % lima_values["Port"],
            '  IdentityFile "%s"' % lima_values["IdentityFile"],
            '  UserKnownHostsFile "%s"' % known_hosts_path(),
            "  IdentitiesOnly yes",
        ]
    )


def ensure_agent_ssh_config() -> None:
    path = ssh_cfg()
    try:
        with open(path, "r") as handle:
            current = handle.read()
    except OSError:
        return

    if current.startswith(AGENT_SSH_CONFIG_MARKER):
        _, _, rest = current.partition("\n\n")
    else:
        rest = current

    owned = [AGENT_SSH_CONFIG_MARKER, EDITOR_SSH_BLOCK]
    lima_values = parse_lima_ssh_block(rest, VM_HOST)
    if lima_values is None:
        err(
            "yo: %s has no parseable 'Host %s' block (Hostname/Port/IdentityFile) — "
            "skipping the %r ssh alias herdr needs; run yo up to let lima regenerate it"
            % (path, VM_HOST, HERDR_SSH_ALIAS)
        )
    else:
        owned.append(herdr_alias_block(lima_values))

    new_content = "\n".join(owned) + "\n\n" + rest
    if new_content == current:
        return
    atomic_write(path, new_content, 0o600)


HOST_KEY_GLOB = "/etc/ssh/ssh_host_*_key.pub"


def known_hosts_lines(lima_values: Dict[str, str], pubkeys: str) -> List[str]:
    host_port = "[%s]:%s" % (lima_values["Hostname"], lima_values["Port"])
    lines = []
    for raw in pubkeys.splitlines():
        parts = raw.split(None, 2)
        if len(parts) < 2:
            continue
        keytype, key = parts[0], parts[1]
        lines.append("%s %s %s" % (host_port, keytype, key))
    return lines


def ensure_guest_known_hosts() -> None:
    # The herdr_alias_block's UserKnownHostsFile has to be pre-populated with
    # the guest's real key: herdr passes -o StrictHostKeyChecking=yes on the
    # command line for every saved machine, which overrides anything weaker
    # this alias sets, so "no known key yet" can never pass. Fetching it over
    # the operator's own ssh (already trusted via lima's own config, not this
    # alias) is what breaks that chicken-and-egg.
    path = ssh_cfg()
    try:
        with open(path, "r") as handle:
            current = handle.read()
    except OSError:
        return
    lima_values = parse_lima_ssh_block(current, VM_HOST)
    if lima_values is None:
        return

    proc = ssh_run(OPERATOR, ["sh", "-c", "cat %s" % HOST_KEY_GLOB], check=False)
    if proc.returncode != 0:
        raise YoError(
            "yo: could not fetch the guest's ssh host keys (%s) to pin them for the %r ssh "
            "alias: %s" % (HOST_KEY_GLOB, HERDR_SSH_ALIAS, (proc.stderr or proc.stdout or "").strip())
        )

    lines = known_hosts_lines(lima_values, proc.stdout)
    if not lines:
        raise YoError(
            "yo: the guest reported no parseable ssh host keys at %s" % HOST_KEY_GLOB
        )

    atomic_write(known_hosts_path(), "\n".join(lines) + "\n", 0o600)


