def disable_aws_broker() -> None:
    health = aws_broker_health()
    if health is not None:
        stale_pid = health.get("pid")
        if isinstance(stale_pid, int):
            kill_stale_broker(stale_pid)
    removal = ssh_run(AGENT, ["rm", "-f", GUEST_AWS_CONFIG_PATH], check=False)
    if removal.returncode != 0:
        err("yo: could not remove the stale %s in the VM" % GUEST_AWS_CONFIG_PATH)


def broker_needs_restart(
    health: Optional[dict], watch_pid: int, allowed_names: Sequence[str]
) -> bool:
    if health is None:
        return True
    if health.get("watch_pid") != watch_pid:
        return True
    if health.get("allow") != list(allowed_names):
        return True
    return False


def ensure_aws_broker() -> bool:
    if shutil.which("aws") is None:
        err("yo: 'aws' is not on this Mac's PATH — no AWS credentials broker started")
        disable_aws_broker()
        return False
    allowed = aws_allowlist()
    if not allowed:
        err("yo: no SSO profiles in ~/.aws/config — no AWS credentials broker started")
        disable_aws_broker()
        return False

    pid = ha_pid()
    if pid is None:
        raise YoError(
            "cannot read %s's host agent pid (limactl list %s --json) — is it up? yo status"
            % (INSTANCE, INSTANCE)
        )

    allowed_names = sorted(name for name, _ in allowed)
    health = aws_broker_health()
    if broker_needs_restart(health, pid, allowed_names):
        if health is not None:
            stale_pid = health.get("pid")
            if isinstance(stale_pid, int):
                kill_stale_broker(stale_pid)
        start_aws_broker(pid, allowed_names)

    push_aws_guest_files(allowed)
    return True


def herdr_machine_exists(listing_json: str) -> bool:
    try:
        entries = json.loads(listing_json)
    except ValueError:
        raise YoError("herdr machine list --json produced unparseable output")
    if not isinstance(entries, list):
        raise YoError("herdr machine list --json did not print a JSON array")
    return any(
        isinstance(entry, dict) and entry.get("target") == HERDR_SSH_ALIAS for entry in entries
    )


def ensure_herdr_machine() -> None:
    herdr = shutil.which("herdr")
    if herdr is None:
        err("yo: herdr not found on this Mac's PATH — skipping herdr machine registration")
        return
    listing = run([herdr, "machine", "list", "--json"], check=True)
    if herdr_machine_exists(listing.stdout):
        return
    added = run([herdr, "machine", "add", HERDR_SSH_ALIAS, "--label", HERDR_SSH_ALIAS])
    if added.returncode != 0:
        raise YoError(
            "herdr machine add %s failed: %s"
            % (HERDR_SSH_ALIAS, (added.stderr or added.stdout).strip())
        )


@dataclass(frozen=True)
class LimaInfo:
    host_agent_pid: Optional[int]
    port_forwards: List[dict]


def lima_instance_info() -> Optional[LimaInfo]:
    proc = run(["limactl", "list", INSTANCE, "--json"], check=False)
    if proc.returncode != 0:
        return None
    try:
        data = json.loads(proc.stdout.strip())
    except ValueError:
        return None
    pid = data.get("hostAgentPID")
    forwards = data.get("config", {}).get("portForwards", [])
    return LimaInfo(
        host_agent_pid=pid if isinstance(pid, int) else None,
        port_forwards=forwards if isinstance(forwards, list) else [],
    )


def ha_pid() -> Optional[int]:
    info = lima_instance_info()
    return info.host_agent_pid if info else None


def lima_config_gaps() -> List[str]:
    info = lima_instance_info()
    if info is None:
        return []
    expected = {
        OP_GUEST_SOCK: op_sock(),
        AWS_BROKER_GUEST_SOCK: aws_broker_sock(),
    }
    return [
        guest_sock
        for guest_sock, host_sock in expected.items()
        if not any(
            isinstance(forward, dict)
            and forward.get("reverse") is True
            and forward.get("guestSocket") == guest_sock
            and forward.get("hostSocket") == host_sock
            for forward in info.port_forwards
        )
    ]


def lima_config_gap_message(missing: Sequence[str]) -> str:
    return (
        "%s has no reverse forward for %s — restate the full array:\n"
        "    limactl stop %s && limactl edit %s --set '.portForwards = %s' && yo up"
        % (INSTANCE, " and ".join(missing), INSTANCE, INSTANCE, json.dumps(LIMA_PORT_FORWARDS))
    )


def op_probe_alive(proc: subprocess.CompletedProcess) -> bool:
    if proc.returncode == 0:
        return True
    return proc.returncode == 1 and "The agent has no identities" in proc.stdout


def aws_broker_probe_alive(proc: subprocess.CompletedProcess) -> bool:
    return proc.returncode == 0


@dataclass(frozen=True)
class ReverseForward:
    name: str
    guest_path: str
    host_path: str
    probe: Tuple[str, ...]
    alive: Callable[[subprocess.CompletedProcess], bool]


def one_password_forward() -> ReverseForward:
    return ReverseForward("1password", OP_GUEST_SOCK, op_sock(), ("ssh-add", "-l"), op_probe_alive)


def aws_broker_forward() -> ReverseForward:
    return ReverseForward(
        "aws-broker",
        AWS_BROKER_GUEST_SOCK,
        aws_broker_sock(),
        ("curl", "-sS", "--unix-socket", AGENT_AWS_BROKER_SOCK, "http://broker/health"),
        aws_broker_probe_alive,
    )


def forward_control_cmd(action: str, forward: ReverseForward) -> List[str]:
    return ssh_base(OPERATOR, mux=True) + [
        "-O",
        action,
        "-R",
        "%s:%s" % (forward.guest_path, forward.host_path),
        VM_HOST,
    ]


def heal_reverse_forward(forward: ReverseForward) -> bool:
    probe = ssh_run(AGENT, list(forward.probe))
    if forward.alive(probe):
        return True
    run(forward_control_cmd("cancel", forward), check=False)
    ssh_run(OPERATOR, ["rm", "-f", forward.guest_path], mux=True, check=True)
    run(forward_control_cmd("forward", forward), check=True)
    probe = ssh_run(AGENT, list(forward.probe))
    return forward.alive(probe)


def heal_forward_collecting_errors(forward: ReverseForward, errors: List[str]) -> None:
    try:
        healed = heal_reverse_forward(forward)
    except YoError as failure:
        errors.append(
            "the %s forward into the VM failed while healing it: %s"
            % (forward.name, failure.message or "unknown error")
        )
        return
    if not healed:
        errors.append("the %s forward into the VM is still dead after re-issuing it" % forward.name)


def ensure_op_forward(aws_enabled: bool) -> List[str]:
    errors: List[str] = []
    if not os.path.exists(op_sock()):
        err(
            "yo: 1Password not running on this Mac (no socket at %s) — skipping its VM forward"
            % op_sock()
        )
    else:
        heal_forward_collecting_errors(one_password_forward(), errors)
    if aws_enabled:
        heal_forward_collecting_errors(aws_broker_forward(), errors)
    return errors


UNITS_MISSING_NOTE = "box predates the 1Password/AWS forwards; run `yo bootstrap`"


def vm_units_present() -> bool:
    return ssh_run(OPERATOR, ["systemctl", "cat", PROXY_SOCKET_UNITS[0]], check=False).returncode == 0


def vm_services() -> None:
    status, _ = account_status()
    if status == "unreachable":
        err("yo: cannot reach %s as operator — is the VM up? yo status" % INSTANCE)
        return
    if not vm_units_present():
        err("yo: %s" % UNITS_MISSING_NOTE)
        return

    errors: List[str] = []
    aws_enabled = False
    try:
        aws_enabled = ensure_aws_broker()
    except YoError as failure:
        errors.append(failure.message or "aws-broker failed")

    errors += ensure_op_forward(aws_enabled)

    if errors:
        raise YoError(
            "; ".join(errors) + " — recreate the master: limactl stop %s && yo up" % INSTANCE
        )


def vm_up(run_services: bool = True) -> None:
    require_kvm()
    gaps = lima_config_gaps()
    if gaps:
        err("yo: %s" % lima_config_gap_message(gaps))
    listing = run(["limactl", "list", "-q"]).stdout.splitlines()
    if INSTANCE in listing:
        run(["limactl", "start", "--yes", INSTANCE], capture=False, check=True)
    else:
        run(
            [
                "limactl",
                "start",
                "--name",
                INSTANCE,
                "--yes",
                str(SCRIPT_DIR / "lima" / "yolobox.yaml"),
            ],
            capture=False,
            check=True,
        )
    ensure_agent_ssh_config()
    ensure_guest_known_hosts()
    if run_services:
        vm_services()


