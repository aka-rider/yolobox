#!/usr/bin/env python3
"""yo — thin host-side CLI for the NixOS-VM yolobox (lima/vz on macOS, libvirt on Linux).

Run `yo --help` for the command reference.
"""

if __name__ == "__main__":
    import sys
    from pathlib import Path

    sys.dont_write_bytecode = True
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    from yolobox_cli.cli import entry

    sys.exit(entry(sys.argv[1:]))
