INCLUDE_LINE = "Include ~/.lima/%s/ssh.config" % INSTANCE

INCLUDE_RE = re.compile(
    r"^\s*Include\s+.*\.lima/%s/ssh\.config" % re.escape(INSTANCE), re.IGNORECASE
)


def ssh_config_include_line() -> Optional[int]:
    path = os.path.join(home(), ".ssh", "config")
    try:
        with open(path, "r", errors="replace") as handle:
            lines = handle.read().splitlines()
    except OSError:
        return None
    for number, line in enumerate(lines, 1):
        if INCLUDE_RE.search(line):
            return number
    return None


def add_ssh_config_include() -> None:
    ssh_dir = os.path.join(home(), ".ssh")
    if not os.path.isdir(ssh_dir):
        os.mkdir(ssh_dir, 0o700)
        os.chmod(ssh_dir, 0o700)
    config_path = os.path.join(ssh_dir, "config")
    try:
        with open(config_path, "r") as handle:
            current = handle.read()
    except OSError:
        current = ""
    atomic_write(config_path, INCLUDE_LINE + "\n" + current, 0o600)


def ensure_ssh_config_include(refuse: bool) -> None:
    if ssh_config_include_line() is not None:
        return

    if sys.stdin.isatty():
        err("yo: ~/.ssh/config does not include the VM's ssh config, so Zed, VS Code and a")
        err("    bare `ssh %s` cannot resolve the host. yo can add one line:" % VM_HOST)
        err("        %s" % INCLUDE_LINE)
        answer = input("    Add it to ~/.ssh/config now? [y/N] ").strip().lower()
        if answer in ("y", "yes"):
            add_ssh_config_include()
            out("yo: added '%s' to ~/.ssh/config" % INCLUDE_LINE)
            return

    err("yo: add this line to ~/.ssh/config so ssh %s, Zed and VS Code can find the VM:" % VM_HOST)
    err("    %s" % INCLUDE_LINE)
    if refuse:
        raise YoError(None, code=1)


