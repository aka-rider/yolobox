    argv = ssh_base(OPERATOR) + forward_agent_opts() + ["-t", VM_HOST] + list(args)
    exec_process(argv)


def cmd_enter(args: Sequence[str]) -> None:
    if len(args) > 1:
        raise usage_error("enter takes at most one project argument")
    require_agent_account()
    target = target_dir(args)

    argv = ssh_base(AGENT) + forward_agent_opts()
    env = dict(os.environ)

    forward = herd_forward()
    if forward is not None:
