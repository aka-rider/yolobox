def cmd_link(args: Sequence[str]) -> None:
    if args:
        raise usage_error("link takes no arguments")
    require_agent_account()
    cdup = run(["git", "rev-parse", "--show-cdup"])
    if cdup.returncode != 0:
        raise YoError("link must run inside a git repo")
    toplevel = os.path.normpath(os.path.join(logical_cwd(), cdup.stdout.strip()))

    if run(["git", "-C", toplevel, "remote", "get-url", "yolobox"]).returncode == 0:
        raise YoError("remote 'yolobox' already exists")
    if toplevel == home():
        raise YoError("refusing to link $HOME itself")
    vmdir = mirror(toplevel)
    if vmdir is None:
        raise YoError("repo must be under $HOME (it is at %s)" % toplevel)
    vmdir = guest_path(vmdir)

    agent_out(["sh", "-c", ENSURE_REPO, "sh", vmdir], check=True)

    run(
        ["git", "-C", toplevel, "remote", "add", "yolobox", "ssh://%s@%s%s" % (AGENT_USER, VM_HOST, vmdir)],
        check=True,
    )
    run(
        [
            "git",
            "-C",
            toplevel,
            "config",
            "remote.yolobox.sshCommand",
            shlex.join(["ssh", "-F", ssh_cfg(), "-o", "ControlPath=none"]),
        ],
        check=True,
    )


def tar_stream(members: Sequence[Tuple[str, str]]) -> bytes:
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w") as archive:
        for path, arcname in members:
            archive.add(path, arcname=arcname, recursive=False)
    return buffer.getvalue()


SEED_STRIP_RE = re.compile(r"^\s*(Include|IdentityAgent)\s", re.IGNORECASE)


def seed_ssh(report: Report) -> None:
    config_path = os.path.join(home(), ".ssh", "config")
    try:
        with open(config_path, "r", errors="replace") as handle:
            lines = handle.read().splitlines(True)
    except OSError:
        report.ok("no ~/.ssh/config on this Mac — skipped")
    else:
        filtered = "".join(line for line in lines if not SEED_STRIP_RE.search(line))
        ssh_run(
            AGENT,
            ["sh", "-c", SEED_SSH_CONFIG],
            stdin=filtered.encode(),
            mux=True,
            capture=False,
            check=True,
        )

    ssh_dir = Path(home()) / ".ssh"
    pubkeys = sorted(str(p) for p in ssh_dir.glob("*.pub") if p.is_file())
    if not pubkeys:
        return
    members = [(path, os.path.basename(path)) for path in pubkeys]
    ssh_run(
        AGENT,
        ["sh", "-c", SEED_UNTAR_SSH],
        stdin=tar_stream(members),
        mux=True,
        capture=False,
        check=True,
    )


def seed_gitconfig() -> None:
    roots = agent_paths(["sh", "-c", GITCONFIG_ROOTS_FIND])
    members = []
    for root in roots:
        if not root or "/" in root or root in (".", ".."):
            continue
        root_path = Path(home()) / root
        if not root_path.is_dir():
            continue
        for identity in sorted(root_path.glob("*/.gitconfig")):
            if identity.is_file():
                members.append((str(identity), str(identity.relative_to(home()))))
    if not members:
        return
    ssh_run(
        AGENT,
        ["sh", "-c", SEED_UNTAR_HOME],
        stdin=tar_stream(members),
        mux=True,
        capture=False,
        check=True,
    )


def cmd_seed(args: Sequence[str]) -> None:
    if args:
        raise usage_error("seed takes no arguments")
    require_agent_account()
    seed_ssh(Report())
    seed_gitconfig()


def herdr_pane_agent(pane_id: str, report: Report, when: str = "") -> str:
    probe = run(["herdr", "pane", "get", pane_id], merge_stderr=True)
    if probe.returncode != 0:
        raise report.abort(
            "'herdr pane get %s' failed%s: %s" % (pane_id, when, probe.stdout.strip()),
            *(
                ["The pane id does not exist on this server — rerun from a live herdr pane."]
                if not when
                else []
            )
        )
    try:
        return json.loads(probe.stdout)["result"]["pane"].get("agent") or ""
    except (ValueError, KeyError, TypeError):
        raise report.abort(
            "could not parse 'herdr pane get' output: %s" % probe.stdout.strip(),
            "Check that the host herdr version still emits JSON from pane get.",
        )


def herdr_server_field(status_text: str, field: str) -> str:
    inside = False
    for line in status_text.splitlines():
        if line.startswith("server:"):
            inside = True
            continue
        if inside:
            if not line.strip():
                break
            match = re.match(r"^\s*%s:\s*(.*)$" % re.escape(field), line)
            if match:
                return match.group(1).strip()
    return ""


def cmd_herd_check(args: Sequence[str]) -> None:
    if args:
        raise usage_error("herd-check takes no arguments")
    report = Report()

    if shutil.which("herdr") is None:
        raise report.abort(
            "herdr is not on this Mac's PATH",
            "Install it (brew install herdr) — the box reports into this Mac's herdr server.",
        )

    status = run(["herdr", "status"], merge_stderr=True)
    if status.returncode != 0:
        raise report.abort(
            "'herdr status' failed: %s" % status.stdout.strip(),
            "Start the herdr server on this Mac, then rerun ./yo herd-check.",
        )
    server_status = herdr_server_field(status.stdout, "status")
    server_compatible = herdr_server_field(status.stdout, "compatible")
    if server_status != "running":
        raise report.abort(
            "this Mac's herdr server is not running (status: %s)" % (server_status or "unknown"),
            "Start it and rerun ./yo herd-check — no report from anywhere lands while it is down.",
        )
    if server_compatible != "yes":
        raise report.abort(
            "this Mac's herdr client and server are incompatible (compatible: %s)"
            % (server_compatible or "unknown"),
            "brew upgrade herdr, then restart the herdr server.",
            "Nothing in the box can work until the Mac's own two halves agree.",
        )
    report.ok("host herdr server running and compatible")

    pane_id = os.environ.get("HERDR_PANE_ID", "")
    if not pane_id:
        raise report.abort(
            "HERDR_PANE_ID is empty — this is not a herdr pane",
            "Run ./yo herd-check from a pane inside herdr's terminal.",
        )

    pane_agent = herdr_pane_agent(pane_id, report)
    if pane_agent:
        raise report.abort(
            "pane %s already holds an agent (%s)" % (pane_id, pane_agent),
            "This check reports an agent into the pane and then releases it, so running",
            "it here would drop %s out of the herd. Open a plain pane and" % pane_agent,
            "rerun ./yo herd-check there.",
        )
    report.ok("pane %s is free" % pane_id)

    host_version = host_herd_version()
    guest = guest_herd_version()
    if guest is None:
        report.fail("cannot ask the box for its herdr version", "Is the VM up? ./yo status")
    elif host_version == guest.version:
        report.ok("herdr %s on both sides" % host_version)
    else:
        report.fail(
            "herd version drift: this Mac runs herdr %s, the box has %s"
            % (host_version, guest.version)
        )
        herd_drift_report(host_version or "", guest.version)
        if (
            guest.prev_version
            and guest.prev_generation != guest.generation
            and guest.prev_version == guest.version
        ):
            err("      The box has been switched since the last check and its herdr did not")
            err("      move: nixpkgs carries no newer one yet. Skip until it does.")

    forward = herd_forward()
    if forward is None:
        raise report.abort(
            "this pane exports no live herdr socket (HERDR_SOCKET_PATH)",
            "The forward yo enter builds cannot exist without it — rerun from a herdr pane.",
        )

    guest_run = ssh_run(
        AGENT,
        ["yolobox-herd-check"],
        extra_opts=forward.ssh_opts,
        env=forward.env,
        capture=False,
    )
    guest_rc = guest_run.returncode
    if guest_rc == 127:
        report.fail("the box has no yolobox-herd-check", "rebuild it: %s" % rebuild_hint())
    elif guest_rc != 0:
        report.fail("the guest half failed (exit %d) — see its output above" % guest_rc)

    pane_agent = herdr_pane_agent(pane_id, report, when=" after the guest run")
    if not pane_agent:
        report.ok("pane %s released again" % pane_id)
    else:
        report.fail(
            "pane %s still holds an agent (%s) after the check" % (pane_id, pane_agent),
            "The guest's release path is broken; clear it by hand with:",
            "herdr pane release-agent %s" % pane_id,
        )

    if report.failed:
        raise YoError(None, code=1)
    if guest_rc != 0:
        raise YoError(None, code=guest_rc)


def guest_field(text: str, key: str) -> str:
    prefix = key + "="
    for line in text.splitlines():
        if line.startswith(prefix):
            return line[len(prefix) :]
    return ""


def cmd_aws_check(args: Sequence[str]) -> None:
    if args:
        raise usage_error("aws-check takes no arguments")
    report = Report()

    profile = os.environ.get("YOLOBOX_AWS_PROFILE", "")
    if not profile:
        raise report.abort(
            "YOLOBOX_AWS_PROFILE is not set",
            "Set it to a host AWS CLI profile and rerun: YOLOBOX_AWS_PROFILE=<profile> ./yo aws-check",
        )
    if shutil.which("aws") is None:
        raise report.abort("'aws' is not on this Mac's PATH")
    report.ok("aws is on this Mac's PATH")

    creds = run(
        ["aws", "configure", "export-credentials", "--profile", profile, "--format", "process"],
        merge_stderr=True,
    )
    if creds.returncode != 0:
        raise report.abort(
            "'aws configure export-credentials --profile %s' failed:" % profile,
            creds.stdout.strip(),
        )
    try:
        session_token = json.loads(creds.stdout).get("SessionToken") or ""
    except ValueError:
        session_token = ""
    if not session_token:
        raise report.abort(
            "profile '%s' returned no SessionToken — these are long-lived keys" % profile,
            "and must never enter the guest. Point YOLOBOX_AWS_PROFILE at a profile that",
            "yields temporary credentials (role_arn or credential_process), not a static",
            "IAM user profile.",
        )
    report.ok("host export-credentials succeeded for '%s', SessionToken present" % profile)

    region = aws_region(profile)
    report.ok("region resolves to %s" % region)

    broker = start_aws_broker(profile)
    try:
        report.ok(
            "broker started, host port %d forwarded to guest port %d"
            % (broker.host_port, broker.guest_port)
        )

        region_opts, region_env = send_env({"AWS_REGION": region})
        env = dict(os.environ)
        env.update(region_env)
        env.update(broker.env)
        guest_out_text = ssh_run(
            AGENT,
            ["bash", "-s"],
            stdin=GUEST_AWS_CHECK.encode(),
            extra_opts=list(broker.ssh_opts) + region_opts,
            env=env,
            merge_stderr=True,
        ).stdout

        if guest_field(guest_out_text, "ENV_MISSING"):
            report.fail(
                "the guest session never saw AWS_CONTAINER_CREDENTIALS_FULL_URI/AWS_CONTAINER_AUTHORIZATION_TOKEN",
                "Check AcceptEnv in nix/base.nix and that the guest is running the switch that carries it.",
            )

        health = guest_field(guest_out_text, "HEALTH")
        if health == "200":
            report.ok("guest curl to the broker's /health returned 200")
        else:
            report.fail(
                "guest curl to the broker's /health returned '%s', expected 200"
                % (health or "<no response>")
            )

        creds_json = guest_field(guest_out_text, "CREDS")
        try:
            payload = json.loads(creds_json)
        except ValueError:
            payload = {}
        expected = {"AccessKeyId", "SecretAccessKey", "Token", "Expiration"}
        if isinstance(payload, dict) and expected <= set(payload):
            report.ok("guest /creds answers with AccessKeyId, SecretAccessKey, Token and Expiration")
        else:
            report.fail("guest /creds did not answer with all four expected keys", creds_json)

        sts_out = guest_field(guest_out_text, "STS")
        try:
            role_arn = json.loads(sts_out).get("Arn") or ""
        except ValueError:
            role_arn = ""
        if role_arn:
            report.ok("guest sts get-caller-identity answers with %s" % role_arn)
        else:
            report.fail("guest sts get-caller-identity did not return a role ARN:", sts_out)
    finally:
        broker.stop()

    if report.failed:
        raise YoError(None, code=1)


