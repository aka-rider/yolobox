#!/usr/bin/env bash
# yolobox — launcher for the blast-radius agentic devbox.
#
# Runs an Ubuntu 26.04 container as the host uid:gid against ONE project dir,
# with the host home/passwd/SECRET_* withheld. The box is a PERSISTENT
# container, one per workdir: the launcher's job on every invocation is to
# ensure the right container exists (create it once, `docker start` it if
# stopped) and then `docker exec` into it — never a throwaway `docker run`.
# Its HOME
# lives on a single Docker named volume (`yolobox-home`), native ext4 in the
# Docker Desktop VM disk image, holding BOTH the agent auth-state and the
# package caches in one place — separate from your real host ~, so the box has
# its own logins and warm caches that survive across runs AND across container
# recreation. /usr/local stays plain, writable image content (never a
# volume; /opt stays root-owned), so ad-hoc tool installs persist for the
# container's life and a rebuilt image always wins; promote anything you want
# to keep into tools/ (see --diff). Launched from a host herd pane, the box's agent reports into
# your HOST herd's live agent list: the box runs a loopback-only sshd
# (unconditionally, whether or not herd is in use) and the host opens an
# OUTBOUND reverse tunnel into it (1Password-authed) that carries the agent's
# status reports — the host never listens. git push goes via that same
# 1Password SSH agent.
#
# Usage:
#   yolobox -w <dir> [--ssh] [--build] [--yes] [--keep] [-- <cmd...>]
#   yolobox -w <dir> --stop|--destroy|--diff [--yes]
#   yolobox --list
#
# The ONLY thing you run. See README.md for the 1Password host prerequisite.

set -euo pipefail

# ---------------------------------------------------------------------------
# Constants — CTR_HOME and CTR_WORK MUST match the paths the Dockerfile bakes
# into the image (the box user's home dir, /work) and that entrypoint.sh
# assumes at PID 1; a mismatch mounts the volume/workdir over the wrong path
# and fails silently (the container starts, just against empty directories).
# ---------------------------------------------------------------------------
readonly IMAGE="yolobox:local"

# Build context = this script's own directory (== /Users/xiii/Developer/yolobox).
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -h "${SCRIPT_SOURCE}" ]; do
    dir="$(cd -P "$(dirname "${SCRIPT_SOURCE}")" >/dev/null 2>&1 && pwd)"
    SCRIPT_SOURCE="$(readlink "${SCRIPT_SOURCE}")"
    case "${SCRIPT_SOURCE}" in
        /*) ;;                       # absolute
        *) SCRIPT_SOURCE="${dir}/${SCRIPT_SOURCE}" ;;
    esac
done
BUILD_DIR="$(cd -P "$(dirname "${SCRIPT_SOURCE}")" >/dev/null 2>&1 && pwd)"
readonly BUILD_DIR

# Fixed container paths (mirror of the runtime contract).
readonly CTR_WORK="/work"
# The in-box username is derived once, here, from the SAME sanitiser
# tools/build.sh uses for the image build — a mismatch between the two would
# build an image whose user disagrees with what this launcher expects.
BOX_USER="$("${BUILD_DIR}/tools/box-user.sh")"
readonly BOX_USER
readonly CTR_HOME="/home/${BOX_USER}"
readonly SSH_SOCK="/run/host-services/ssh-auth.sock"
# The box's unprivileged sshd port (published to 127.0.0.1 only for herd reporting).
readonly CTR_SSHD_PORT="2222"
# The host 1Password SSH agent socket — used to authenticate the reverse herd tunnel
# (the box authorizes whatever pubkeys this agent presents).
readonly OP_SOCK="${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
# The single named volume holding the box's entire $HOME (auth-state + caches).
VOL_HOME="${YOLOBOX_HOME_VOLUME:-yolobox-home}"
readonly VOL_HOME

# ---------------------------------------------------------------------------
# Usage / help.
# ---------------------------------------------------------------------------
usage() {
    cat >&2 <<'EOF'
yolobox — blast-radius Docker devbox for AI coding agents

USAGE:
    yolobox -w <dir> [--ssh] [--build] [--yes] [--keep] [-- <cmd...>]
    yolobox -w <dir> --stop|--destroy|--diff [--yes]
    yolobox --list

REQUIRED:
    -w <dir>            Host project directory -> mounted rw at /work (workdir).
                         Not required for --list.

OPTIONS:
    --ssh               Forward the host 1Password SSH agent for git push/sign.
    --build             Force a rebuild of the yolobox:local image.
    --yes               Recreate an out-of-date box without prompting.
    --keep              Abort instead of recreating an out-of-date box.
    --stop              Stop the box's container (docker stop) and exit.
    --destroy           Print `docker diff`, then remove the box's container
                        (docker rm -f) and exit. Confirms unless --yes.
    --diff              Print `docker diff` for the box's container and exit
                        — the ad-hoc-install -> tools/ promotion workflow.
    --list              List every yolobox container (docker ps -a) and exit.
                        Does not require -w.
    -- <cmd...>         Run <cmd...> instead of the default shell handoff.
    -h, --help          Show this help.

HOME: the box's HOME lives on a single Docker named volume (yolobox-home),
native ext4 in the Docker Desktop VM disk image — not a host bind mount. Log
into agents once inside the box (or drop credentials there) and it persists
across runs and across container recreation, separate from your real host ~.

SECURITY: runs --user <host uid:gid> --cap-drop=ALL --security-opt
no-new-privileges. Host env is a strict allowlist (never --env-file) with NO
exceptions: no SECRET_*, *_TOKEN, *_KEY or *_PASSWORD variable is ever
forwarded — not even an agent API key. Log agents in inside the box;
credentials persist in the box's own home volume, never your real ~.
/usr/local is writable inside the box's own container (non-root
ownership, not a read-only rootfs, is what protects the rest of the
filesystem); /opt stays root-owned. Ad-hoc tool installs into /usr/local
persist across sessions; promote anything you want to keep into tools/
(see --diff).
EOF
}

die() {
    echo "yolobox: $*" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Argument parsing.
# ---------------------------------------------------------------------------
WORKDIR=""
SSH_FORWARD=0
FORCE_BUILD=0
ASSUME_YES=0
KEEP_BOX=0
ACTION=""
CMD=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        -w)
            [ "$#" -ge 2 ] || die "-w requires a directory argument"
            WORKDIR="$2"
            shift 2
            ;;
        --ssh)
            SSH_FORWARD=1
            shift
            ;;
        --build)
            FORCE_BUILD=1
            shift
            ;;
        --yes)
            ASSUME_YES=1
            shift
            ;;
        --keep)
            KEEP_BOX=1
            shift
            ;;
        --stop)
            ACTION=stop
            shift
            ;;
        --destroy)
            ACTION=destroy
            shift
            ;;
        --diff)
            ACTION="diff"
            shift
            ;;
        --list)
            ACTION=list
            shift
            ;;
        --)
            shift
            # Everything after -- is the command to run in the box.
            while [ "$#" -gt 0 ]; do
                CMD+=("$1")
                shift
            done
            break
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "yolobox: unknown argument: $1" >&2
            usage
            exit 1
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Validate -w (mandatory except for --list, which is not box-specific).
# ---------------------------------------------------------------------------
if [ "${ACTION}" != list ]; then
    [ -n "${WORKDIR}" ] || { echo "yolobox: -w <dir> is required" >&2; usage; exit 1; }
    case "${ACTION}" in
        stop|destroy|diff)
            # These only need CTR_NAME (derived via resolve_real, which tolerates
            # a non-existent path) — the workdir may already be gone.
            ;;
        *)
            [ -d "${WORKDIR}" ] || die "-w: not a directory: ${WORKDIR}"
            WORKDIR="$(cd "${WORKDIR}" >/dev/null 2>&1 && pwd)" || die "-w: cannot resolve: ${WORKDIR}"
            ;;
    esac
fi

command -v docker >/dev/null 2>&1 || die "docker not found on PATH"

# --list is not box-specific: dispatch immediately, before any -w-dependent
# discovery below.
if [ "${ACTION}" = list ]; then
    docker ps -a --filter 'label=yolobox.config' --format '{{.Names}}\t{{.Status}}'
    exit 0
fi

# ---------------------------------------------------------------------------
# Reject host paths containing ':' — docker's `-v host:ctr[:opts]` mount spec is
# colon-delimited, so a ':' in a source path silently mis-parses into a bogus
# destination/option rather than erroring.
# ---------------------------------------------------------------------------
case "${WORKDIR}" in
    *:*) die "path contains ':' which breaks docker -v mount specs: ${WORKDIR}" ;;
esac

warn() { echo "yolobox: $*" >&2; }

# ---------------------------------------------------------------------------
# Docker Desktop file-sharing awareness (macOS). Docker Desktop only bind-mounts
# host paths under its configured File Sharing roots; mounting anything else
# aborts the ENTIRE `docker create`/`docker run`. Read those roots so we can
# hard-fail -w with a helpful message instead of a confusing docker error.
# ---------------------------------------------------------------------------
SHARED_DIRS=()
while IFS= read -r _line; do
    [ -n "${_line}" ] && SHARED_DIRS+=("${_line}")
done < <(
    for f in \
        "${HOME}/Library/Group Containers/group.com.docker/settings-store.json" \
        "${HOME}/Library/Group Containers/group.com.docker/settings.json"; do
        [ -f "${f}" ] || continue
        python3 - "${f}" <<'PY' 2>/dev/null && break
import json,sys
d=json.load(open(sys.argv[1]))
for x in (d.get('FilesharingDirectories') or d.get('filesharingDirectories') or []):
    print(x)
PY
    done
)

resolve_real() { python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null || echo "$1"; }

# is_shared PATH -> 0 if PATH resolves under a shared root (or if we couldn't read
# the share list at all, in which case we let docker itself arbitrate).
is_shared() {
    [ "${#SHARED_DIRS[@]}" -eq 0 ] && return 0
    local rp; rp="$(resolve_real "$1")"
    local d
    for d in "${SHARED_DIRS[@]}"; do
        case "${rp}/" in "${d%/}/"*) return 0 ;; esac
    done
    return 1
}

case "${ACTION}" in
    list|stop|destroy|diff) ;;
    *)
        if ! is_shared "${WORKDIR}"; then
            die "-w ${WORKDIR} is not in Docker Desktop's File Sharing list.
Add it under Docker Desktop -> Settings -> Resources -> File Sharing, or use a
path under one of the shared roots: ${SHARED_DIRS[*]}"
        fi
        ;;
esac

# ---------------------------------------------------------------------------
# Container identity. One box per workdir — forced, not chosen: `docker start`
# replays the creation config, so a container created with -v projA:/work can
# never serve project B. The sshd port is DERIVED from the same hash rather than
# allocated per run, because a create-time container identity cannot depend on a
# value that changes every invocation.
# ---------------------------------------------------------------------------
_wd_real="$(resolve_real "${WORKDIR}")"
_wd_hash="$(printf %s "${_wd_real}" | shasum | cut -c1-8)"
# `tr -d '\n'` FIRST: without it, basename's trailing newline is a non-matching
# char that `tr -c` rewrites to '_', appending a stray underscore to every
# container name.
CTR_NAME="yolobox-$(basename "${_wd_real}" | tr -d '\n' | tr -c 'a-zA-Z0-9_.-' '_')-${_wd_hash}"
# 0x prefix avoids bash's octal trap on leading zeros; % binds tighter than +,
# so the range is exactly 40000-59999.
HERD_SSH_PORT=$(( 40000 + 0x${_wd_hash:0:4} % 20000 ))
# Explicit override, so a collision has a remedy that is not "move the project".
HERD_SSH_PORT="${YOLOBOX_SSH_PORT:-${HERD_SSH_PORT}}"
readonly CTR_NAME HERD_SSH_PORT

# ---------------------------------------------------------------------------
# --stop / --destroy / --diff dispatch here: they need CTR_NAME, just computed.
# ---------------------------------------------------------------------------
case "${ACTION}" in
    stop)
        docker inspect "${CTR_NAME}" >/dev/null 2>&1 || die "no such box: ${CTR_NAME} (nothing to stop for -w ${WORKDIR})"
        docker stop "${CTR_NAME}" >/dev/null
        exit 0
        ;;
    destroy)
        if docker inspect "${CTR_NAME}" >/dev/null 2>&1; then
            warn "destroying ${CTR_NAME}; changes in its writable layer (promote anything you want to keep into tools/):"
            docker diff "${CTR_NAME}" >&2 || true
            if [ "${ASSUME_YES}" -ne 1 ]; then
                if [ -t 0 ]; then
                    printf 'yolobox: destroy %s and lose the above? [y/N] ' "${CTR_NAME}" >&2
                    read -r _ans; case "${_ans}" in y|Y) ;; *) die "aborted" ;; esac
                else
                    die "${CTR_NAME} exists; re-run with --yes (non-interactive)"
                fi
            fi
            docker rm -f "${CTR_NAME}" >/dev/null
        fi
        exit 0
        ;;
    diff)
        docker inspect "${CTR_NAME}" >/dev/null 2>&1 || die "no such box: ${CTR_NAME} (nothing to diff for -w ${WORKDIR})"
        exec docker diff "${CTR_NAME}"
        ;;
esac

# ---------------------------------------------------------------------------
# Build the image if missing or if --build was requested. Routed through
# tools/build.sh, the ONE place the USERNAME/UID/GID build-arg triple is
# assembled — duplicating that logic here risks it drifting out of sync with
# the image build.
# ---------------------------------------------------------------------------
if [ "${FORCE_BUILD}" -eq 1 ] || ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
    echo "yolobox: building ${IMAGE} (username=${BOX_USER} uid=$(id -u) gid=$(id -g))..." >&2
    "${BUILD_DIR}/tools/build.sh"
fi

# ---------------------------------------------------------------------------
# Seed the box's herd config and SSH authorized_keys from the host. The host
# cannot write into a named volume directly, so both pipe over stdin into a
# throwaway container. MUST run AFTER the image-build block above: both `docker
# run` calls reference ${IMAGE}, which does not exist yet on a first-ever
# invocation until the block above builds it — and since these calls sit on the
# left arm of an `&&` list, `set -e` would NOT catch that failure; it would
# just silently skip seeding.
# ---------------------------------------------------------------------------
_host_herdr_cfg="${HOME}/.config/herdr/config.toml"
if [ -f "${_host_herdr_cfg}" ]; then
    docker run --rm -i --user "$(id -u):$(id -g)" -v "${VOL_HOME}:/home" \
        --entrypoint sh "${IMAGE}" -c '
            d="'"${CTR_HOME}"'/.config/herdr"
            [ -f "$d/config.toml" ] && exit 0
            mkdir -p "$d" && cat > "$d/config.toml"
        ' < "${_host_herdr_cfg}" \
        && echo "yolobox: seeded box herdr config from ${_host_herdr_cfg}" >&2
fi

# Authorize exactly the pubkeys the host 1Password agent presents. Seeded
# unconditionally (not just under --ssh): WP5.S6b makes the box's sshd
# unconditional too, so seeding the keys unconditionally is the matching
# behavior. A no-op without a running 1Password agent.
if [ -S "${OP_SOCK}" ]; then
    _authorized_keys="$(SSH_AUTH_SOCK="${OP_SOCK}" ssh-add -L 2>/dev/null || true)"
    if [ -n "${_authorized_keys}" ]; then
        printf '%s\n' "${_authorized_keys}" | docker run --rm -i --user "$(id -u):$(id -g)" \
            -v "${VOL_HOME}:/home" --entrypoint sh "${IMAGE}" -c '
                d="'"${CTR_HOME}"'/.ssh"
                mkdir -p "$d" && cat > "$d/authorized_keys" && chmod 600 "$d/authorized_keys"
            ' && echo "yolobox: seeded box authorized_keys from the 1Password agent" >&2
    fi
fi

# ---------------------------------------------------------------------------
# Assemble the `docker create` argument vector.
# ---------------------------------------------------------------------------
CREATE_ARGS=(
    create --name "${CTR_NAME}"
    # -- Hardening (ALWAYS) --
    --user "$(id -u):$(id -g)"
    --cap-drop=ALL
    --security-opt no-new-privileges
    # NOTE: the read-only-rootfs flag is deliberately absent — /usr/local
    # must be writable so tools can be installed ad-hoc and later promoted into a
    # tools/ module. The box runs NON-ROOT, so it can only write what it owns: the
    # build chowns /usr/local to it, while /opt, /etc, /usr/bin and /lib stay
    # root-owned. /var/tmp and /dev/shm are mode 1777 and thus writable too.
    --tmpfs /tmp
    # sshd needs a writable /run. Unconditional: it cannot be added by a later
    # `docker exec`, and making it herd-conditional would tie the container's
    # identity to whether this invocation happened to run inside a herd pane.
    --tmpfs /run
    # Chromium (Playwright MCP) crashes on Docker's default 64MB /dev/shm and
    # needs a real init to reap its process tree. Both are hardening-neutral.
    --shm-size=1g
    --init
    # -- The ONE mount that masks the image: user data only. Native ext4 in the
    #    VM disk image, no VirtioFS round-trip. --
    -v "${VOL_HOME}:/home"
    # -- The one project directory (still a host bind mount, by design) --
    -v "${WORKDIR}:${CTR_WORK}"
    --workdir "${CTR_WORK}"
    # -- Docker Desktop's SSH-agent bridge. Mounted ALWAYS, gated by whether
    #    SSH_AUTH_SOCK is exported at exec time (--ssh). Mounting it here rather
    #    than under `if --ssh` is what keeps toggling --ssh from destroying the
    #    box. It carries the host agent PROTOCOL; no private key ever enters. --
    -v "${SSH_SOCK}:${SSH_SOCK}"
    # -- Box sshd, published on loopback only, for the herd reverse tunnel. Also
    #    unconditional, for the same reason as --tmpfs /run. --
    -p "127.0.0.1:${HERD_SSH_PORT}:${CTR_SSHD_PORT}"
    # Tells entrypoint.sh that the LAUNCHER will run yolobox-init, so it must not
    # run it too — otherwise create races two concurrent inits. Constant across
    # invocations, so it does not perturb CONFIG_HASH.
    -e "YOLOBOX_MANAGED=1"
)

# ---------------------------------------------------------------------------
# Environment allowlist — ABSOLUTE. NEVER --env-file; NEVER forward SECRET_*/
# *_TOKEN/*_KEY/*_PASSWORD, including any agent API key. Agent auth-state lives
# in the yolobox-home VOLUME mounted at /home: log in once inside the box and the
# credential persists across runs. Only the vars below (plus herdr/ssh vars added
# later in this script) ever reach the container.
# ---------------------------------------------------------------------------
ENV_ARGS=()
# HOME must be ${CTR_HOME} at exec time. The image ENV also pins it, but a
# numeric --user makes Docker try to default HOME=/; set it explicitly as
# belt-and-braces.
ENV_ARGS+=( -e "HOME=${CTR_HOME}" )
# Runtime-only ENV overrides: one -e pair per TOOL_RUNTIME_ENV entry declared
# by a tools/NN-*.sh module (e.g. tools/12-rust.sh re-points CARGO_HOME onto
# the writable home volume, with a CARGO_INSTALL_ROOT precedence pin, so cargo
# installs persist across container recreation instead of landing in the
# image's writable layer). Generated by `tools/build.sh` from the modules into
# tools/runtime-env.generated, WITHOUT substituting its @HOME@ placeholder --
# only this launcher knows the runtime home path, so it substitutes here.
#
# Read from that generated file rather than sourcing the modules themselves:
# several modules command-substitute `uname` at source time, and this script
# runs under `set -euo pipefail` on every single invocation, so a module
# top-level returning non-zero would abort the launcher outright.
RUNTIME_ENV_FILE="${BUILD_DIR}/tools/runtime-env.generated"
[ -f "${RUNTIME_ENV_FILE}" ] || die "missing ${RUNTIME_ENV_FILE} -- run tools/build.sh first (it generates this file from the tools/NN-*.sh modules; without it, runtime env overrides like CARGO_HOME are silently omitted and caches land in the container's writable layer instead of the /home volume)"
while IFS= read -r _rt_line; do
    case "${_rt_line}" in
        ''|'#'*) continue ;;
    esac
    ENV_ARGS+=( -e "${_rt_line//@HOME@/${CTR_HOME}}" )
done < "${RUNTIME_ENV_FILE}"
# Advertise "you are inside yolobox" to the whole box (prompts, agents).
ENV_ARGS+=( -e "YOLOBOX=1" )
# LANG defaults to en_US.UTF-8 (the locale generated in the image).
ENV_ARGS+=( -e "LANG=${LANG:-en_US.UTF-8}" )
# Pass TERM/COLORTERM through only if set on the host, so colors/keys work.
if [ -n "${TERM:-}" ]; then
    ENV_ARGS+=( -e "TERM=${TERM}" )
fi
if [ -n "${COLORTERM:-}" ]; then
    ENV_ARGS+=( -e "COLORTERM=${COLORTERM}" )
fi

# ---------------------------------------------------------------------------
# herdr integration — the box's agent appears in your HOST herd's live list.
#
# herdr's server can't absorb a container (it spawns panes as host-side children),
# but every agent populates the list the same way: a small hook self-reports status
# to the herd socket (`pane.report_agent`, keyed by $HERDR_PANE_ID) — plain JSON
# over an AF_UNIX stream, no fd-passing, so it survives an SSH tunnel. Docker Desktop
# can't bind-mount a live host socket across its VM (VirtioFS), so instead we forward
# the host herd socket INTO the box over SSH (authed by the forwarded 1Password
# agent, no key in the box) and let the box's hook report through it.
#
# We integrate ONLY when launched from inside a host herd pane — i.e. this process
# already carries that pane's HERDR_ENV/HERDR_PANE_ID/HERDR_SOCKET_PATH. The box's
# agent then reports ONTO that pane and shows up beside your other host agents.
# Otherwise the box gets its OWN standalone herd socket on tmpfs.
#
# This block contributes ONLY -e pairs (HERD_ENV_ARGS), consumed at `docker
# exec` time — never mounts or ports: those are unconditional in CREATE_ARGS
# above, fixed at container create time, and cannot be changed per-invocation.
# ---------------------------------------------------------------------------
HERD_ENV_ARGS=()
HERD_INTEGRATE=0
if [ "${HERDR_ENV:-}" = "1" ] && [ -n "${HERDR_PANE_ID:-}" ] \
   && [ -n "${HERDR_SOCKET_PATH:-}" ] && [ -S "${HERDR_SOCKET_PATH}" ]; then
    HERD_INTEGRATE=1
    HOST_HERD_SOCK="${HERDR_SOCKET_PATH}"
    HERD_ENV_ARGS+=(
        -e "HERDR_ENV=1"
        -e "HERDR_PANE_ID=${HERDR_PANE_ID}"
        # The box's hook connects here; the host reverse-forwards it to HOST_HERD_SOCK.
        -e "HERDR_SOCKET_PATH=/tmp/herdr/host.sock"
        -e "YOLOBOX_HERD=1"
    )
    warn "herd: box agent will report into this host herd (pane ${HERDR_PANE_ID}) via 127.0.0.1:${HERD_SSH_PORT}"
else
    # Standalone: the box's own herd (default entrypoint) needs a bindable socket.
    HERD_ENV_ARGS+=( -e "HERDR_SOCKET_PATH=/tmp/herdr/herdr.sock" )
fi

# ---------------------------------------------------------------------------
# --ssh: forward the host 1Password SSH agent. No private key enters the box;
# only the agent protocol crosses the socket. The mount itself is unconditional
# in CREATE_ARGS above; --ssh only toggles whether SSH_AUTH_SOCK is exported at
# `docker exec` time (below), so toggling it never recreates the box.
# ---------------------------------------------------------------------------
if [ "${SSH_FORWARD}" -eq 1 ]; then
    # Pre-flight: Docker Desktop is launched by launchd and ignores shell env,
    # so the bridge only reaches 1Password when SSH_AUTH_SOCK is set via
    # launchctl AND Docker Desktop was fully restarted afterward. Warn (do not
    # hard-fail) if it looks misconfigured.
    current_sock="$(launchctl getenv SSH_AUTH_SOCK 2>/dev/null || true)"
    case "${current_sock}" in
        *1password*) ;;  # looks good
        *)
            cat >&2 <<EOF
yolobox: --ssh may not reach 1Password. The Docker Desktop SSH bridge needs the
launchd SSH_AUTH_SOCK to point at the 1Password agent. Current value:
    ${current_sock:-<unset>}
Fix (then FULLY restart Docker Desktop):
    launchctl setenv SSH_AUTH_SOCK "\$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
Continuing anyway...
EOF
            ;;
    esac
fi

# ---------------------------------------------------------------------------
# Identity hashes. Computed AFTER CREATE_ARGS is complete and BEFORE the labels
# are appended, so CONFIG_HASH never feeds itself.
# ---------------------------------------------------------------------------
IMAGE_ID="$(docker image inspect -f '{{.Id}}' "${IMAGE}")"
CONFIG_HASH="$(printf '%s\n' "${CREATE_ARGS[@]}" | shasum | cut -c1-12)"
CREATE_ARGS+=(
    --label "yolobox.image=${IMAGE_ID}"
    --label "yolobox.config=${CONFIG_HASH}"
    "${IMAGE}" sleep infinity     # parked no-op: entrypoint runs, box stays up
)

# ---------------------------------------------------------------------------
# Lifecycle: ensure the container exists in the right state, then exec into it.
# ---------------------------------------------------------------------------
# NOTE: `docker inspect -f` on a MISSING object exits 1 *and* prints an empty
# line to stdout (verified on Docker 29.6.1). So the obvious
# `$(docker inspect ... || echo absent)` yields "\nabsent", never plain "absent",
# and every run would fall into the "container exists" branch below and die on
# the unguarded label lookups. Normalise explicitly instead.
_ctr_state=absent
_s="$(docker inspect -f '{{.State.Status}}' "${CTR_NAME}" 2>/dev/null || true)"
_s="$(printf %s "${_s}" | tr -d '[:space:]')"
if [ -n "${_s}" ]; then _ctr_state="${_s}"; fi
unset _s
if [ "${_ctr_state}" != absent ]; then
    _old_img="$(docker inspect -f '{{index .Config.Labels "yolobox.image"}}' "${CTR_NAME}")"
    _old_cfg="$(docker inspect -f '{{index .Config.Labels "yolobox.config"}}' "${CTR_NAME}")"
    if [ "${_old_img}" != "${IMAGE_ID}" ] || [ "${_old_cfg}" != "${CONFIG_HASH}" ]; then
        warn "${CTR_NAME} was created from a different image/config and must be recreated."
        warn "changes in its writable layer (promote anything you want to keep into tools/):"
        # docker diff reads exactly the writable layer — where ad-hoc installs to
        # /usr/local and /opt live. /home is a volume and correctly does not appear.
        docker diff "${CTR_NAME}" >&2 || true
        if [ "${ASSUME_YES}" -ne 1 ]; then
            [ "${KEEP_BOX}" -eq 1 ] && die "aborted (--keep); run without --keep to recreate"
            if [ -t 0 ]; then
                printf 'yolobox: recreate %s and lose the above? [y/N] ' "${CTR_NAME}" >&2
                read -r _ans; case "${_ans}" in y|Y) ;; *) die "aborted" ;; esac
            else
                die "${CTR_NAME} is out of date; re-run with --yes (non-interactive)"
            fi
        fi
        docker rm -f "${CTR_NAME}" >/dev/null
        _ctr_state=absent
    fi
fi
case "${_ctr_state}" in
    absent)
        # Fail loudly on collision. `docker create` accepts a taken port and only
        # `docker start` fails ("port is already allocated"), leaving the container
        # wedged in state `created` — every later run then takes the `docker start`
        # arm and fails identically, with no diagnostic and no recovery but --destroy.
        if ! python3 -c 'import socket,sys
s=socket.socket()
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(1)
finally:
    s.close()' "${HERD_SSH_PORT}" 2>/dev/null; then
            die "port ${HERD_SSH_PORT} (derived from ${_wd_real}) is already in use.
Set YOLOBOX_SSH_PORT=<free port> to override, or free the port."
        fi
        docker "${CREATE_ARGS[@]}" >/dev/null
        docker start "${CTR_NAME}" >/dev/null
        ;;
    running) : ;;
    *)       docker start "${CTR_NAME}" >/dev/null ;;
esac

# Per-session init, run SYNCHRONOUSLY before handing over. `docker start` returns
# as soon as PID 1 is spawned, so anything the ENTRYPOINT does asynchronously
# (per-module runtime seeding, cache dirs) would otherwise race the
# session exec — the shell could start before ~/.zshrc or a harness's seeded
# MCP config exist. Running it as its own exec removes the race by
# construction rather than by waiting.
# yolobox-init is idempotent, so the running/stopped paths pay only a no-op.
docker exec "${CTR_NAME}" /usr/local/bin/yolobox-init \
    || warn "yolobox-init exited non-zero; continuing"

# Every session is an exec: -w/-e/-t are per-invocation, which is exactly what a
# restarted container cannot change.
EXEC_ARGS=( exec --workdir "${CTR_WORK}" )
if [ -t 0 ] && [ -t 1 ]; then EXEC_ARGS+=( -it ); else EXEC_ARGS+=( -i ); fi
# Guard EVERY array expansion: bash 3.2 (macOS ships bash 3.2) errors with
# "ENV_ARGS[@]: unbound variable" under `set -u` when the array is empty.
EXEC_ARGS+=( "${ENV_ARGS[@]+"${ENV_ARGS[@]}"}" )   # allowlist above
[ "${SSH_FORWARD}" -eq 1 ] && EXEC_ARGS+=( -e "SSH_AUTH_SOCK=${SSH_SOCK}" )
EXEC_ARGS+=( "${HERD_ENV_ARGS[@]+"${HERD_ENV_ARGS[@]}"}" )
EXEC_ARGS+=( "${CTR_NAME}" )
if [ "${#CMD[@]}" -gt 0 ]; then EXEC_ARGS+=( "${CMD[@]}" )
else EXEC_ARGS+=( /usr/local/bin/yolobox-shell ); fi

if [ "${HERD_INTEGRATE}" -eq 1 ]; then
    # Host-side reverse tunnel — per-invocation and host-side, so it needs no
    # change to the container. ssh retries the connection until the box's sshd
    # answers (ConnectionAttempts), so there's no sleep/poll; the box authorizes
    # our 1Password key. The tunnel carries only the box agent's status reports;
    # it dies with the box.
    (
        SSH_AUTH_SOCK="${OP_SOCK}" \
        exec ssh -N -T \
            -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -o ConnectionAttempts=60 -o ConnectTimeout=1 \
            -o ExitOnForwardFailure=yes -o StreamLocalBindUnlink=yes \
            -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
            -p "${HERD_SSH_PORT}" \
            -R "/tmp/herdr/host.sock:${HOST_HERD_SOCK}" \
            "${BOX_USER}@127.0.0.1" >/dev/null 2>&1
    ) &
    _tunnel_pid=$!
    trap 'kill "${_tunnel_pid}" 2>/dev/null' EXIT INT TERM
    set +e
    docker "${EXEC_ARGS[@]}"
    _rc=$?
    set -e
    kill "${_tunnel_pid}" 2>/dev/null || true
    exit "${_rc}"
fi
exec docker "${EXEC_ARGS[@]}"
