#!/usr/bin/env bash
# yolobox-shell — the default-command handoff, run when the launcher's `docker
# exec` was NOT given a `-- cmd`. `docker exec` never runs the image
# ENTRYPOINT, so this is what the launcher execs directly in that case.
#
#   * INTEGRATION mode (launched from a host herd pane; YOLOBOX_HERD=1) — do NOT
#     start the box's own herd. It would be a herd nested inside a host herd pane,
#     which herd disables ("nested herdr is disabled by default"), and HERDR_ENV=1
#     (set so Claude's report hooks fire) trips that guard regardless. Drop to a
#     login shell in this host-tracked pane instead; run `claude` here and it reports
#     up to your host herd like the `-- claude` form.
#   * STANDALONE (plain terminal) — drop into herdr, the box's own multiplexer, using
#     your seeded config. It's a TUI, so with no TTY fall back to a login shell.

set -uo pipefail

if [ "${YOLOBOX_HERD:-}" = "1" ]; then
    echo "yolobox: in a host herd pane — starting a shell (a nested box herd is disabled;" \
         "run 'claude' here and it reports to your host herd, or use '-- claude')." >&2
    exec zsh -l
elif [ -t 0 ] && [ -t 1 ] && command -v herdr >/dev/null 2>&1; then
    exec herdr
else
    exec zsh -l
fi
