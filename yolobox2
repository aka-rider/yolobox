#!/usr/bin/env bash
# yolobox2 — thin Mac-side CLI for the NixOS-VM yolobox (lima/vz).
#
# Usage:
#   yolobox2 up|down|status
#   yolobox2 ssh [cmd...]
#   yolobox2 enter [herdr-args...]
#   yolobox2 link
#   yolobox2 seed-herdr

set -euo pipefail

readonly INSTANCE="yolobox"
readonly VM_HOST="lima-yolobox"
# ".guest" suffix: lima >= 2.1.0 renames the guest home (see README).
readonly VM_USER_HOME="/home/xiii.guest"
SSH_CFG="$HOME/.lima/yolobox/ssh.config"
OP_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
readonly SSH_CFG OP_SOCK

# Script dir resolution (symlink-safe, no readlink -f).
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -h "${SCRIPT_SOURCE}" ]; do
    dir="$(cd -P "$(dirname "${SCRIPT_SOURCE}")" >/dev/null 2>&1 && pwd)"
    SCRIPT_SOURCE="$(readlink "${SCRIPT_SOURCE}")"
    case "${SCRIPT_SOURCE}" in
        /*) ;; # absolute
        *) SCRIPT_SOURCE="${dir}/${SCRIPT_SOURCE}" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_SOURCE}")" >/dev/null 2>&1 && pwd)"
readonly SCRIPT_DIR

usage() {
    cat >&2 <<EOF
Usage:
  yolobox2 up|down|status
  yolobox2 ssh [cmd...]
  yolobox2 enter [herdr-args...]
  yolobox2 link
  yolobox2 seed-herdr
EOF
}

# ssh_config values containing spaces need literal quotes inside the
# -o argument itself (its own tokenizer splits on whitespace otherwise) —
# the 1Password socket path lives under "Group Containers". Every caller
# must use this: lima's ssh.config sets ControlMaster auto + ControlPersist
# yes on a shared ControlPath, so whichever invocation establishes the
# master decides whether agent forwarding exists for every later session.
# Sets the SSH_ARGS array (macOS ships bash 3.2, which has no mapfile).
ssh_args() {
    SSH_ARGS=(-F "${SSH_CFG}" -o "IdentityAgent=\"${OP_SOCK}\"" -o ForwardAgent=yes)
}

cmd_up() {
    if limactl list -q | grep -qx "${INSTANCE}"; then
        limactl start --yes "${INSTANCE}"
    else
        limactl start --name "${INSTANCE}" --yes "${SCRIPT_DIR}/lima/yolobox.yaml"
    fi
}

cmd_down() {
    limactl stop "${INSTANCE}"
}

cmd_status() {
    limactl list "${INSTANCE}"
}

cmd_ssh() {
    ssh_args
    SSH_ARGS+=(-t "${VM_HOST}")
    exec ssh "${SSH_ARGS[@]}" "${@+"$@"}"
}

# herdr --remote installs its own binary into the guest ~/.local/bin on
# version drift, shadowing the nix-pinned /run/current-system/sw/bin/herdr —
# so parity is checked, not assumed. This only applies to the HERDR_ENV=1
# remote-attach path below; plain ssh never touches a host herdr binary at
# all. HERDR_REMOTE_BINARY cannot substitute for this check: it names a
# *local* (client-side) binary path for `herdr --remote` to copy over on a
# platform match, not a path on the remote host, so it cannot pin the guest
# binary.
check_herdr_version_parity() {
    command -v herdr >/dev/null 2>&1 || {
        echo "yolobox2: herdr not found on host; install it or use 'yolobox2 ssh' instead" >&2
        exit 1
    }
    host_version="$(herdr --version)"
    ssh_args
    guest_version="$(ssh "${SSH_ARGS[@]}" "${VM_HOST}" herdr --version)"
    if [ "${host_version}" != "${guest_version}" ]; then
        echo "yolobox2: herdr version mismatch: host '${host_version}' vs guest '${guest_version}'" >&2
        echo "yolobox2: bump yolobox.harness.herdr.version/hash in nix/harnesses.nix and rebuild, or upgrade the host binary" >&2
        exit 1
    fi
}

cmd_enter() {
    if [ "${HERDR_ENV:-}" = "1" ]; then
        check_herdr_version_parity
        # herdr --remote shells out to plain ssh against ~/.ssh/config, so it
        # never sees ssh_args()'s -F/-o flags — ForwardAgent must come from
        # ~/.ssh/config itself.
        cfg="$(ssh -G "${VM_HOST}")"
        hostname_val="$(printf '%s\n' "${cfg}" | awk '$1 == "hostname" { print $2; exit }')"
        forwardagent_val="$(printf '%s\n' "${cfg}" | awk '$1 == "forwardagent" { print $2; exit }')"
        if [ "${hostname_val}" = "${VM_HOST}" ] || [ -z "${hostname_val}" ] || [ "${forwardagent_val}" != "yes" ]; then
            cat >&2 <<EOF
yolobox2: ~/.ssh/config does not resolve ${VM_HOST} with ForwardAgent yes.
Add this to the TOP of ~/.ssh/config, above the existing "Host *":

Include ~/.lima/yolobox/ssh.config
Host ${VM_HOST}
  ForwardAgent yes
EOF
            exit 1
        fi
        exec herdr --remote "${VM_HOST}" --remote-keybindings server "$@"
    else
        ssh_args
        exec ssh "${SSH_ARGS[@]}" -t "${VM_HOST}" herdr
    fi
}

# Resolve $1 relative to a base dir via cd+pwd -P; empty on failure.
relative_to() {
    base_real="$(cd -P "$1" 2>/dev/null && pwd)" || return 1
    target_real="$2"
    case "${target_real}" in
        "${base_real}")
            printf '%s\n' "."
            ;;
        "${base_real}"/*)
            printf '%s\n' "${target_real#"${base_real}"/}"
            ;;
        *)
            return 1
            ;;
    esac
}

cmd_link() {
    toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || {
        echo "yolobox2: link must run inside a git repo" >&2
        exit 1
    }

    if git -C "${toplevel}" remote get-url yolobox >/dev/null 2>&1; then
        echo "yolobox2: remote 'yolobox' already exists" >&2
        exit 1
    fi

    toplevel_real="$(cd -P "${toplevel}" && pwd)"

    relpath="$(relative_to "$HOME/Developer" "${toplevel_real}")" || {
        echo "yolobox2: repo must be under \$HOME/Developer" >&2
        exit 1
    }
    if [ "${relpath}" = "." ]; then
        echo "yolobox2: refusing to link \$HOME/Developer itself" >&2
        exit 1
    fi

    vmdir="${VM_USER_HOME}/wrk/${relpath}"

    ssh_args
    # shellcheck disable=SC2029 # vmdir must expand client-side to embed the guest path literally
    ssh "${SSH_ARGS[@]}" "${VM_HOST}" \
        "mkdir -p '${vmdir}' && { git -C '${vmdir}' rev-parse --git-dir >/dev/null 2>&1 || { git -C '${vmdir}' init -b main && git -C '${vmdir}' config receive.denyCurrentBranch updateInstead; }; }"

    git -C "${toplevel}" remote add yolobox "ssh://${VM_HOST}${vmdir}"
    git -C "${toplevel}" config core.sshCommand "ssh -F ${SSH_CFG}"
}

cmd_seed_herdr() {
    host_cfg="$HOME/.config/herdr/config.toml"
    ssh_args
    cat "${host_cfg}" | ssh "${SSH_ARGS[@]}" "${VM_HOST}" \
        'mkdir -p ~/.config/herdr && { [ -e ~/.config/herdr/config.toml ] || cat > ~/.config/herdr/config.toml; }'
}

main() {
    [ "$#" -ge 1 ] || {
        usage
        exit 2
    }
    sub="$1"
    shift
    case "${sub}" in
        up) cmd_up ;;
        down) cmd_down ;;
        status) cmd_status ;;
        ssh) cmd_ssh "$@" ;;
        enter) cmd_enter "$@" ;;
        link) cmd_link ;;
        seed-herdr) cmd_seed_herdr ;;
        *)
            usage
            exit 2
            ;;
    esac
}

main "$@"
